@using TorrentRuler.Engine.Actions
@using TorrentRuler.Web.Pages.History
@model TorrentRuler.Core.Domain.RunRecord
@* What one run did: the torrents it matched, its actions by outcome, its errors, and the raw
   recorded details. There is no separate per-run log; DetailsJson is everything that was stored. *@
@{
    var details = IndexModel.ParseDetails(Model.DetailsJson);
    var torrents = details.Select(d => (d.InstanceId, d.TorrentHash)).Distinct().ToList();
    var byAction = details.GroupBy(d => d.ActionType).ToList();
    var errors = details.Where(d => !string.IsNullOrEmpty(d.Error)).ToList();
    var raw = IndexModel.PrettyDetails(Model.DetailsJson);
}
<div class="qf-run-details">
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger py-2 mb-3 qf-cell-wrap">
            <strong>Run failed:</strong> @Model.ErrorMessage
            <button type="button" class="btn btn-sm btn-ghost-danger ms-1 qf-copy" data-copy-text="@Model.ErrorMessage" aria-label="Copy error message"><i class="ti ti-copy" aria-hidden="true"></i></button>
        </div>
    }

    <div class="row g-3">
        <section class="col-lg-4">
            <h3 class="h6 d-flex align-items-center gap-2">Torrents (@torrents.Count)
                @if (torrents.Count > 0)
                {
                    <button type="button" class="btn btn-sm btn-ghost-secondary qf-copy" data-copy-text="@string.Join("\n", torrents.Select(t => t.TorrentHash))" aria-label="Copy all torrent hashes"><i class="ti ti-copy" aria-hidden="true"></i></button>
                }
            </h3>
            @if (torrents.Count == 0)
            {
                <p class="small text-secondary mb-0">No per-torrent actions recorded.</p>
            }
            else
            {
                <ul class="list-unstyled small mb-0 qf-hash-list">
                    @foreach (var t in torrents.Take(100))
                    {
                        <li>
                            <code title="@t.TorrentHash">@t.TorrentHash[..Math.Min(12, t.TorrentHash.Length)]</code>
                            <span class="text-secondary">· instance @t.InstanceId</span>
                            <button type="button" class="btn btn-sm btn-ghost-secondary py-0 qf-copy" data-copy-text="@t.TorrentHash" aria-label="Copy hash @t.TorrentHash"><i class="ti ti-copy" aria-hidden="true"></i></button>
                        </li>
                    }
                    @if (torrents.Count > 100) { <li class="text-secondary">…and @(torrents.Count - 100) more</li> }
                </ul>
            }
        </section>

        <section class="col-lg-4">
            <h3 class="h6">Actions</h3>
            @if (byAction.Count == 0)
            {
                <p class="small text-secondary mb-0">None ran.</p>
            }
            else
            {
                <ul class="list-unstyled small mb-0">
                    @foreach (var g in byAction)
                    {
                        <li class="mb-1">
                            <span class="fw-medium">@g.Key.Replace("Action", "")</span>:
                            @string.Join(", ", g.GroupBy(r => r.Outcome).Select(o => $"{o.Count()} {o.Key switch { ActionOutcome.Applied => "applied", ActionOutcome.DryRun => "dry run", ActionOutcome.SkippedAlreadyMatching => "already matching", ActionOutcome.Failed => "failed", _ => o.Key.ToString() }}"))
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="col-lg-4">
            <h3 class="h6">Errors (@errors.Count)</h3>
            @if (errors.Count == 0)
            {
                <p class="small text-secondary mb-0">None.</p>
            }
            else
            {
                <ul class="list-unstyled small mb-0">
                    @foreach (var e in errors.Take(50))
                    {
                        <li class="text-danger qf-cell-wrap mb-1"><code>@e.TorrentHash[..Math.Min(8, e.TorrentHash.Length)]</code> @e.ActionType.Replace("Action", ""): @e.Error</li>
                    }
                </ul>
            }
        </section>
    </div>

    <details class="mt-3">
        <summary class="small">Raw run details (JSON)</summary>
        <div class="position-relative">
            <button type="button" class="btn btn-sm btn-outline-secondary qf-copy position-absolute top-0 end-0 m-2" data-copy-text="@raw" aria-label="Copy raw run details"><i class="ti ti-copy" aria-hidden="true"></i></button>
            <pre class="qf-sql-preview mt-2 mb-0 qf-raw-details">@raw</pre>
        </div>
    </details>
</div>

@page
@model TorrentRuler.Web.Pages.History.IndexModel
@{
    ViewData["Title"] = "Run history";
    var hasFilters = Model.RuleId is not null || Model.Outcome is not null || Model.From is not null || Model.To is not null;
}

<button class="button is-small is-hidden-tablet is-fullwidth mb-2 qf-ico-btn"
        type="button" data-collapse-target="#historyFilters"
        aria-expanded="false" aria-controls="historyFilters">
    <i class="ti ti-filter" aria-hidden="true"></i>Filters
</button>

<div class="qf-collapse-mobile-only" id="historyFilters">
    <div class="qf-card mb-3">
        <div class="qf-card-body">
            <form method="get" class="columns is-multiline is-variable is-2 is-align-items-end">
                <div class="column is-3-tablet">
                    <label class="label small mb-1" for="historyRuleId">Rule</label>
                    <div class="select is-small is-fullwidth">
                        <select id="historyRuleId" name="RuleId">
                            <option value="">All rules</option>
                            @foreach (var rule in Model.AllRules)
                            {
                                <option value="@rule.Id" selected="@(Model.RuleId == rule.Id)">@rule.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="column is-2-tablet">
                    <label class="label small mb-1" for="historyOutcome">Outcome</label>
                    <div class="select is-small is-fullwidth">
                        <select id="historyOutcome" name="Outcome">
                            <option value="">Any</option>
                            @foreach (var outcome in Enum.GetValues<TorrentRuler.Core.Domain.RunOutcome>())
                            {
                                <option value="@outcome" selected="@(Model.Outcome == outcome)">@outcome</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="column is-2-tablet">
                    <label class="label small mb-1" for="historyFrom">From</label>
                    <input id="historyFrom" type="date" name="From" class="input is-small" value="@(Model.From?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="column is-2-tablet">
                    <label class="label small mb-1" for="historyTo">To</label>
                    <input id="historyTo" type="date" name="To" class="input is-small" value="@(Model.To?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="column is-3-tablet">
                    <button type="submit" class="button is-small is-primary qf-ico-btn"><i class="ti ti-filter" aria-hidden="true"></i>Filter</button>
                    <a asp-page="/History/Index" class="button is-small qf-ico-btn"><i class="ti ti-x" aria-hidden="true"></i>Clear</a>
                </div>
            </form>
        </div>
    </div>
</div>

@if (hasFilters)
{
    <div class="is-flex is-flex-wrap-wrap is-align-items-center is-gap-2 mb-3">
        @if (Model.RuleId is not null)
        {
            <a class="tag qf-ico-btn text-decoration-none" asp-page="/History/Index"
               asp-route-Outcome="@Model.Outcome" asp-route-From="@Model.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.To?.ToString("yyyy-MM-dd")">
                Rule: @Model.RuleNamesById.GetValueOrDefault(Model.RuleId.Value, "?")<i class="ti ti-x" aria-hidden="true"></i>
            </a>
        }
        @if (Model.Outcome is not null)
        {
            <a class="tag qf-ico-btn text-decoration-none" asp-page="/History/Index"
               asp-route-RuleId="@Model.RuleId" asp-route-From="@Model.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.To?.ToString("yyyy-MM-dd")">
                Outcome: @Model.Outcome<i class="ti ti-x" aria-hidden="true"></i>
            </a>
        }
        @if (Model.From is not null)
        {
            <a class="tag qf-ico-btn text-decoration-none" asp-page="/History/Index"
               asp-route-RuleId="@Model.RuleId" asp-route-Outcome="@Model.Outcome" asp-route-To="@Model.To?.ToString("yyyy-MM-dd")">
                From: @Model.From.Value.ToString("MMM d")<i class="ti ti-x" aria-hidden="true"></i>
            </a>
        }
        @if (Model.To is not null)
        {
            <a class="tag qf-ico-btn text-decoration-none" asp-page="/History/Index"
               asp-route-RuleId="@Model.RuleId" asp-route-Outcome="@Model.Outcome" asp-route-From="@Model.From?.ToString("yyyy-MM-dd")">
                To: @Model.To.Value.ToString("MMM d")<i class="ti ti-x" aria-hidden="true"></i>
            </a>
        }
        <a class="button is-small is-text text-decoration-none p-0 ms-1" asp-page="/History/Index">Clear all</a>
    </div>
}

<div class="qf-card">
    <div class="qf-card-body p-0">
        @if (Model.Runs.Count == 0)
        {
            <div class="qf-empty">
                <div class="qf-empty-icon ti ti-history" aria-hidden="true"></div>
                <p class="mb-0">No runs match these filters.</p>
            </div>
        }
        else
        {
            <div class="is-hidden-touch table-container">
                <table class="table is-narrow align-middle mb-0">
                    <thead>
                    <tr>
                        <th></th>
                        <th>Rule</th>
                        <th>Started</th>
                        <th>Duration</th>
                        <th>Outcome</th>
                        <th class="has-text-right">Matched</th>
                        <th class="has-text-right">Applied</th>
                        <th class="has-text-right is-hidden-touch">Skipped</th>
                        <th class="has-text-right">Failed</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var run in Model.Runs)
                    {
                        var detailId = $"details-{run.Id}";
                        var details = TorrentRuler.Web.Pages.History.IndexModel.ParseDetails(run.DetailsJson);
                        var duration = run.FinishedAt is not null ? (run.FinishedAt.Value - run.StartedAt) : (TimeSpan?)null;
                        <tr>
                            <td>
                                @if (details.Count > 0 || run.ErrorMessage is not null)
                                {
                                    <button class="button is-small is-text p-0 qf-detail-toggle" data-collapse-target="#@detailId" aria-expanded="false" aria-label="Toggle details"><i class="ti ti-chevron-down" aria-hidden="true"></i></button>
                                }
                            </td>
                            <td>@(Model.RuleNamesById.GetValueOrDefault(run.RuleId, "(deleted rule)"))</td>
                            <td class="text-secondary"><partial name="_RelativeTime" model="run.StartedAt" /></td>
                            <td class="text-secondary">@(duration is not null ? $"{duration.Value.TotalSeconds:0.0}s" : "—")</td>
                            <td>
                                <partial name="_StatusBadge" model="run.Outcome" />
                                @if (run.WasDryRun)
                                {
                                    <span class="qf-badge qf-badge-secondary ms-1">dry-run</span>
                                }
                            </td>
                            <td class="has-text-right">@run.MatchedCount</td>
                            <td class="has-text-right">@run.ActionsExecutedCount</td>
                            <td class="has-text-right is-hidden-touch">@run.ActionsSkippedCount</td>
                            <td class="has-text-right @(run.ActionsFailedCount > 0 ? "has-text-danger has-text-weight-semibold" : "")">@run.ActionsFailedCount</td>
                        </tr>
                        <tr class="qf-collapse" id="@detailId">
                            <td colspan="9" class="qf-detail-panel">
                                @if (run.ErrorMessage is not null)
                                {
                                    <div class="notification is-danger is-light py-2 mb-2">@run.ErrorMessage</div>
                                }
                                @if (details.Count > 0)
                                {
                                    <table class="table is-narrow mb-0">
                                        <thead><tr><th>Torrent hash</th><th>Action</th><th>Outcome</th><th>Error</th></tr></thead>
                                        <tbody>
                                        @foreach (var d in details)
                                        {
                                            <tr>
                                                <td class="qf-muted-mono">@d.TorrentHash</td>
                                                <td>@d.ActionType</td>
                                                <td>@d.Outcome</td>
                                                <td class="has-text-danger">@d.Error</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="is-hidden-desktop qf-row-card-list">
            @foreach (var run in Model.Runs)
            {
                var detailId = $"details-mobile-{run.Id}";
                var details = TorrentRuler.Web.Pages.History.IndexModel.ParseDetails(run.DetailsJson);
                var duration = run.FinishedAt is not null ? (run.FinishedAt.Value - run.StartedAt) : (TimeSpan?)null;
                var hasDetails = details.Count > 0 || run.ErrorMessage is not null;
                <div class="qf-row-card">
                    <div class="qf-row-card-top">
                        <span class="qf-row-card-title is-flex-grow-1">@(Model.RuleNamesById.GetValueOrDefault(run.RuleId, "(deleted rule)"))</span>
                        <partial name="_StatusBadge" model="run.Outcome" />
                    </div>
                    @if (run.WasDryRun)
                    {
                        <span class="qf-badge qf-badge-secondary mb-1">dry-run</span>
                    }
                    <dl class="qf-row-card-meta">
                        <dt>Started</dt><dd><partial name="_RelativeTime" model="run.StartedAt" /></dd>
                        <dt>Duration</dt><dd>@(duration is not null ? $"{duration.Value.TotalSeconds:0.0}s" : "—")</dd>
                        <dt>Matched</dt><dd>@run.MatchedCount</dd>
                        <dt>Applied</dt><dd>@run.ActionsExecutedCount</dd>
                        <dt>Failed</dt><dd class="@(run.ActionsFailedCount > 0 ? "has-text-danger has-text-weight-semibold" : "")">@run.ActionsFailedCount</dd>
                    </dl>
                    @if (hasDetails)
                    {
                        <button class="button is-small is-fullwidth mt-2 qf-ico-btn qf-detail-toggle is-justify-content-center" type="button"
                                data-collapse-target="#@detailId" aria-expanded="false" aria-controls="@detailId">
                            <i class="ti ti-chevron-down" aria-hidden="true"></i>Details
                        </button>
                        <div class="qf-collapse mt-2" id="@detailId">
                            <div class="qf-detail-panel">
                                @if (run.ErrorMessage is not null)
                                {
                                    <div class="notification is-danger is-light py-2 mb-2">@run.ErrorMessage</div>
                                }
                                @foreach (var d in details)
                                {
                                    <div class="small mb-2">
                                        <div class="qf-muted-mono">@d.TorrentHash</div>
                                        <div>@d.ActionType &mdash; @d.Outcome</div>
                                        @if (!string.IsNullOrEmpty(d.Error))
                                        {
                                            <div class="has-text-danger">@d.Error</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="pagination is-small p-3" role="navigation" aria-label="pagination">
                    <ul class="pagination-list mb-0">
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li>
                                <a class="pagination-link @(p == Model.PageNumber ? "is-current is-selected" : "")" asp-page="/History/Index"
                                   asp-route-PageNumber="@p" asp-route-RuleId="@Model.RuleId" asp-route-Outcome="@Model.Outcome"
                                   asp-route-From="@Model.From?.ToString("yyyy-MM-dd")" asp-route-To="@Model.To?.ToString("yyyy-MM-dd")">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</div>

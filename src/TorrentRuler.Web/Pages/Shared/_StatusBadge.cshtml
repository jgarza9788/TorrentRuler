@model TorrentRuler.Core.Domain.RunOutcome
@{
    var (cls, icon, label) = Model switch
    {
        TorrentRuler.Core.Domain.RunOutcome.Success => ("qf-badge-success", "ti-circle-check", "Success"),
        TorrentRuler.Core.Domain.RunOutcome.PartialFailure => ("qf-badge-warning", "ti-alert-triangle", "Partial failure"),
        TorrentRuler.Core.Domain.RunOutcome.Failed => ("qf-badge-danger", "ti-circle-x", "Failed"),
        TorrentRuler.Core.Domain.RunOutcome.Skipped => ("qf-badge-secondary", "ti-circle-minus", "Skipped"),
        _ => ("qf-badge-secondary", "ti-help-circle", Model.ToString())
    };
}
<span class="qf-badge @cls"><i class="ti @icon" aria-hidden="true"></i>@label</span>

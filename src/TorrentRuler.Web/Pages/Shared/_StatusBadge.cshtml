@model TorrentRuler.Core.Domain.RunOutcome
@{
    var (cls, icon, label) = Model switch
    {
        TorrentRuler.Core.Domain.RunOutcome.Success => ("qf-badge-success", "bi-check-circle-fill", "Success"),
        TorrentRuler.Core.Domain.RunOutcome.PartialFailure => ("qf-badge-warning", "bi-exclamation-triangle-fill", "Partial failure"),
        TorrentRuler.Core.Domain.RunOutcome.Failed => ("qf-badge-danger", "bi-x-circle-fill", "Failed"),
        TorrentRuler.Core.Domain.RunOutcome.Skipped => ("qf-badge-secondary", "bi-dash-circle", "Skipped"),
        _ => ("qf-badge-secondary", "bi-question-circle", Model.ToString())
    };
}
<span class="qf-badge @cls"><i class="bi @icon" aria-hidden="true"></i>@label</span>

@using Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - torrentruler</title>
    <script>
        // Applied before first paint so there's no flash of the wrong theme.
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('torrentruler-theme'); } catch (e) {}
            var theme = stored || 'dark';
            if (theme !== 'auto') {
                document.documentElement.setAttribute('data-theme', theme);
            }
        })();
    </script>
    <link rel="icon" type="image/svg+xml" href="~/img/icon.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#212529" />
    <link rel="stylesheet" href="~/lib/tabler-icons/dist/tabler-icons.min.css" />
    <!-- EXPERIMENT: Bulma in place of Tabler/Bootstrap -- see wwwroot/lib/bulma -->
    <link rel="stylesheet" href="~/lib/bulma/css/bulma.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        bool IsActive(string prefix) => currentPage == prefix
            || currentPage.StartsWith(prefix + "/", StringComparison.Ordinal);
    }
    <header>
        <nav class="navbar qf-navbar" role="navigation" aria-label="main navigation"
             x-data="{ mobileOpen: false }">
            <div class="container is-fluid">
                <div class="navbar-brand">
                    <a class="navbar-item qf-logo-link" asp-page="/Index" title="torrentruler">
                        <img src="~/img/icon.svg" alt="" class="qf-logo" />
                        <span class="qf-brand ml-2">torrentruler</span>
                    </a>
                    <a role="button" class="navbar-burger" :class="{ 'is-active': mobileOpen }"
                       aria-label="menu" :aria-expanded="mobileOpen" @@click="mobileOpen = !mobileOpen">
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                    </a>
                </div>
                <div class="navbar-menu" :class="{ 'is-active': mobileOpen }">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="navbar-start">
                            <a class="navbar-item qf-ico-btn @(IsActive("/Index") ? "is-active" : "")"
                               aria-current="@(IsActive("/Index") ? "page" : null)" asp-page="/Index">
                                <i class="ti ti-dashboard" aria-hidden="true"></i>Dashboard
                            </a>
                            <a class="navbar-item qf-ico-btn @(IsActive("/Rules") ? "is-active" : "")"
                               aria-current="@(IsActive("/Rules") ? "page" : null)" asp-page="/Rules/Index">
                                <i class="ti ti-checklist" aria-hidden="true"></i>Rules
                            </a>
                            <a class="navbar-item qf-ico-btn @(IsActive("/Instances") ? "is-active" : "")"
                               aria-current="@(IsActive("/Instances") ? "page" : null)" asp-page="/Instances/Index">
                                <i class="ti ti-plug-connected" aria-hidden="true"></i>Instances
                            </a>
                            <a class="navbar-item qf-ico-btn @(IsActive("/History") ? "is-active" : "")"
                               aria-current="@(IsActive("/History") ? "page" : null)" asp-page="/History/Index">
                                <i class="ti ti-history" aria-hidden="true"></i>History
                            </a>
                            <a class="navbar-item qf-ico-btn @(IsActive("/Settings") ? "is-active" : "")"
                               aria-current="@(IsActive("/Settings") ? "page" : null)" asp-page="/Settings/Index">
                                <i class="ti ti-settings" aria-hidden="true"></i>Settings
                            </a>
                        </div>
                        <div class="navbar-end">
                            <div class="navbar-item">
                                <div class="qf-theme-toggle" role="group" aria-label="Theme">
                                    <button type="button" class="button" data-theme-choice="light" title="Light" aria-label="Light" aria-pressed="false">
                                        <i class="ti ti-sun" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="button" data-theme-choice="dark" title="Dark" aria-label="Dark" aria-pressed="false">
                                        <i class="ti ti-moon-stars" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="button" data-theme-choice="auto" title="Match system" aria-label="Match system" aria-pressed="false">
                                        <i class="ti ti-circle-half" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                            <a class="navbar-item qf-ico-btn" asp-page="/Account/ChangePassword">
                                <i class="ti ti-key" aria-hidden="true"></i>Change password
                            </a>
                            <div class="navbar-item">
                                <form method="post" action="/Logout">
                                    <button type="submit" class="button is-text qf-ico-btn">
                                        <i class="ti ti-logout" aria-hidden="true"></i>Log out
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container is-fluid qf-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        (function () {
            var buttons = document.querySelectorAll('[data-theme-choice]');
            function apply(theme) {
                if (theme === 'auto') {
                    document.documentElement.removeAttribute('data-theme');
                } else {
                    document.documentElement.setAttribute('data-theme', theme);
                }
                try { localStorage.setItem('torrentruler-theme', theme); } catch (e) {}
                buttons.forEach(function (b) {
                    var on = b.getAttribute('data-theme-choice') === theme;
                    b.classList.toggle('is-active', on);
                    b.setAttribute('aria-pressed', on ? 'true' : 'false');
                });
            }
            buttons.forEach(function (b) {
                b.addEventListener('click', function () { apply(b.getAttribute('data-theme-choice')); });
            });
            var stored = null;
            try { stored = localStorage.getItem('torrentruler-theme'); } catch (e) {}
            apply(stored || 'dark');
        })();
    </script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/lib/alpinejs/alpine.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

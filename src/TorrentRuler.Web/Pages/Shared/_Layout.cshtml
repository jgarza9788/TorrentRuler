@using Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - torrentruler</title>
    <script>
        // Applied before first paint so there's no flash of the wrong theme.
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('torrentruler-theme'); } catch (e) {}
            var theme = stored || 'auto';
            if (theme !== 'auto') {
                document.documentElement.setAttribute('data-bs-theme', theme);
            }
        })();
    </script>
    <link rel="icon" type="image/svg+xml" href="~/img/icon.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#212529" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TorrentRuler.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        bool IsActive(string prefix) => currentPage == prefix
            || currentPage.StartsWith(prefix + "/", StringComparison.Ordinal);
    }
    <header>
        <nav class="navbar navbar-expand-lg border-bottom qf-navbar">
            <div class="container-fluid">
                <a class="qf-logo-link" asp-page="/Index" title="torrentruler">
                    <img src="~/img/icon.svg" alt="" class="qf-logo" />
                    <span class="qf-brand ms-2">torrentruler</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#qfNav"
                        aria-controls="qfNav" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="offcanvas offcanvas-end offcanvas-lg" tabindex="-1" id="qfNav" aria-labelledby="qfNavLabel">
                    <div class="offcanvas-header d-lg-none">
                        <h5 class="offcanvas-title" id="qfNavLabel">torrentruler</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body d-flex flex-column flex-lg-row">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <ul class="navbar-nav me-auto">
                                <li class="nav-item">
                                    <a class="nav-link qf-ico-btn @(IsActive("/Index") ? "active" : "")"
                                       aria-current="@(IsActive("/Index") ? "page" : null)" asp-page="/Index">
                                        <i class="bi bi-speedometer2" aria-hidden="true"></i>Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link qf-ico-btn @(IsActive("/Rules") ? "active" : "")"
                                       aria-current="@(IsActive("/Rules") ? "page" : null)" asp-page="/Rules/Index">
                                        <i class="bi bi-list-check" aria-hidden="true"></i>Rules
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link qf-ico-btn @(IsActive("/Instances") ? "active" : "")"
                                       aria-current="@(IsActive("/Instances") ? "page" : null)" asp-page="/Instances/Index">
                                        <i class="bi bi-plug-fill" aria-hidden="true"></i>Instances
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link qf-ico-btn @(IsActive("/History") ? "active" : "")"
                                       aria-current="@(IsActive("/History") ? "page" : null)" asp-page="/History/Index">
                                        <i class="bi bi-clock-history" aria-hidden="true"></i>History
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link qf-ico-btn @(IsActive("/Settings") ? "active" : "")"
                                       aria-current="@(IsActive("/Settings") ? "page" : null)" asp-page="/Settings/Index">
                                        <i class="bi bi-gear-fill" aria-hidden="true"></i>Settings
                                    </a>
                                </li>
                            </ul>
                            <ul class="navbar-nav">
                                <li class="nav-item d-flex align-items-center">
                                    <div class="qf-theme-toggle" role="group" aria-label="Theme">
                                        <button type="button" class="btn" data-theme-choice="light" title="Light" aria-label="Light" aria-pressed="false">
                                            <i class="bi bi-sun-fill" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="btn" data-theme-choice="dark" title="Dark" aria-label="Dark" aria-pressed="false">
                                            <i class="bi bi-moon-stars-fill" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="btn" data-theme-choice="auto" title="Match system" aria-label="Match system" aria-pressed="false">
                                            <i class="bi bi-circle-half" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link qf-ico-btn" asp-page="/Account/ChangePassword">
                                        <i class="bi bi-key-fill" aria-hidden="true"></i>Change password
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <form method="post" action="/Logout">
                                        <button type="submit" class="btn btn-link nav-link qf-ico-btn">
                                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>Log out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid qf-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var buttons = document.querySelectorAll('[data-theme-choice]');
            function apply(theme) {
                if (theme === 'auto') {
                    document.documentElement.removeAttribute('data-bs-theme');
                } else {
                    document.documentElement.setAttribute('data-bs-theme', theme);
                }
                try { localStorage.setItem('torrentruler-theme', theme); } catch (e) {}
                buttons.forEach(function (b) {
                    var on = b.getAttribute('data-theme-choice') === theme;
                    b.classList.toggle('active', on);
                    b.setAttribute('aria-pressed', on ? 'true' : 'false');
                });
            }
            buttons.forEach(function (b) {
                b.addEventListener('click', function () { apply(b.getAttribute('data-theme-choice')); });
            });
            var stored = null;
            try { stored = localStorage.getItem('torrentruler-theme'); } catch (e) {}
            apply(stored || 'auto');
        })();
    </script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/lib/alpinejs/alpine.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

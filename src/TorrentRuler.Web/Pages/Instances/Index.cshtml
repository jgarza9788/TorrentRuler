@page
@using TorrentRuler.Web
@using TorrentRuler.Web.Pages.Shared
@model TorrentRuler.Web.Pages.Instances.IndexModel
@{
    ViewData["Title"] = "Instances";
}

<div class="qf-card mb-4">
    <div class="qf-card-header">
        <h2>Data source instances</h2>
        <div class="d-flex align-items-center gap-2">
            @if (Model.Instances.Count > 0)
            {
                <input type="search" class="form-control form-control-sm qf-table-filter"
                       data-table-filter placeholder="Filter&hellip;" aria-label="Filter instances" />
                <form method="post" asp-page-handler="TestAll">
                    <button type="submit" class="btn btn-sm btn-outline-secondary qf-ico-btn text-nowrap" aria-label="Test all enabled instances">
                        <i class="ti ti-plug-connected" aria-hidden="true"></i><span class="d-none d-sm-inline">Test all</span>
                    </button>
                </form>
            }
            <a asp-page="/Instances/Edit" class="btn btn-sm btn-primary qf-ico-btn text-nowrap" aria-label="Add instance"><i class="ti ti-plus" aria-hidden="true"></i><span class="d-none d-sm-inline">Add instance</span></a>
        </div>
    </div>
    <div class="qf-card-body p-0">
        @if (Model.Instances.Count == 0)
        {
            <partial name="_EmptyState" model='new EmptyStateModel("plug-connected", "No instances yet",
                "torrentruler needs at least one qBittorrent instance to act on; add media servers and history sources to use their data in rules.",
                "Add your first instance", Url.Page("/Instances/Edit"))' />
        }
        else
        {
            <div class="d-none d-md-block qf-table-wrap">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Enabled</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Base URL</th>
                        <th>Last connection test</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var instance in Model.Instances)
                    {
                        <tr>
                            <td>
                                <form method="post" asp-page-handler="ToggleEnabled" asp-route-id="@instance.Id">
                                    <div class="form-check form-switch qf-toggle-switch">
                                        <input type="checkbox" class="form-check-input" role="switch"
                                               @(instance.Enabled ? "checked" : "") onchange="this.form.submit()"
                                               aria-label="Enable @instance.Name" />
                                    </div>
                                </form>
                            </td>
                            <td class="fw-medium">@instance.Name</td>
                            <td class="text-secondary">@instance.SourceType</td>
                            <td>
                                <span class="d-inline-flex align-items-center gap-1 qf-url-cell">
                                    <span class="qf-muted-mono text-secondary text-truncate" title="@instance.BaseUrl">@instance.BaseUrl</span>
                                    <a href="@instance.BaseUrl" target="_blank" rel="noopener noreferrer" class="qf-icon-link"
                                       aria-label="Open @instance.Name in a new tab" title="Open in a new tab"><i class="ti ti-external-link" aria-hidden="true"></i></a>
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-start gap-2">
                                    <form method="post" asp-page-handler="TestConnection" asp-route-id="@instance.Id"
                                          hx-post="?handler=TestConnection&id=@instance.Id" hx-target="#instance-status-@instance.Id" hx-swap="outerHTML">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary qf-ico-btn" aria-label="Test connection to @instance.Name"><i class="ti ti-refresh" aria-hidden="true"></i>Test</button>
                                    </form>
                                    <partial name="_InstanceStatus" model="instance" />
                                </div>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-page="/Instances/Edit" asp-route-id="@instance.Id" class="btn btn-sm btn-outline-secondary qf-ico-btn"><i class="ti ti-pencil" aria-hidden="true"></i>Edit</a>
                                <form method="post" asp-page-handler="DeleteInstance" asp-route-id="@instance.Id" class="d-inline"
                                      data-confirm="Delete instance &quot;@instance.Name&quot;? Rules targeting it will stop matching anything on it." data-confirm-ok="Delete">
                                    <button type="submit" class="btn btn-sm btn-outline-danger qf-ico-btn"><i class="ti ti-trash" aria-hidden="true"></i>Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-md-none qf-row-card-list">
            @foreach (var instance in Model.Instances)
            {
                <div class="qf-row-card">
                    <div class="qf-row-card-top">
                        <form method="post" asp-page-handler="ToggleEnabled" asp-route-id="@instance.Id">
                            <div class="form-check form-switch qf-toggle-switch">
                                <input type="checkbox" class="form-check-input" role="switch"
                                       @(instance.Enabled ? "checked" : "") onchange="this.form.submit()"
                                       aria-label="Enable @instance.Name" />
                            </div>
                        </form>
                        <span class="qf-row-card-title flex-grow-1">@instance.Name</span>
                        <div class="dropdown qf-row-card-actions">
                            <button class="btn btn-sm btn-outline-secondary border-0" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @instance.Name">
                                <i class="ti ti-dots-vertical" aria-hidden="true"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-page="/Instances/Edit" asp-route-id="@instance.Id"><i class="ti ti-pencil me-2" aria-hidden="true"></i>Edit</a></li>
                                <li><a class="dropdown-item" href="@instance.BaseUrl" target="_blank" rel="noopener noreferrer"><i class="ti ti-external-link me-2" aria-hidden="true"></i>Open in new tab</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-page-handler="DeleteInstance" asp-route-id="@instance.Id"
                                          data-confirm="Delete instance &quot;@instance.Name&quot;? Rules targeting it will stop matching anything on it." data-confirm-ok="Delete">
                                        <button type="submit" class="dropdown-item text-danger"><i class="ti ti-trash me-2" aria-hidden="true"></i>Delete</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <dl class="qf-row-card-meta">
                        <dt>Type</dt><dd>@instance.SourceType</dd>
                        <dt>Base URL</dt><dd class="qf-muted-mono text-secondary" title="@instance.BaseUrl">@instance.BaseUrl</dd>
                    </dl>
                    <div class="d-flex align-items-start gap-2 mt-2">
                        <form method="post" asp-page-handler="TestConnection" asp-route-id="@instance.Id"
                              hx-post="?handler=TestConnection&id=@instance.Id" hx-target="next .qf-conn-status" hx-swap="outerHTML">
                            <button type="submit" class="btn btn-sm btn-outline-secondary qf-ico-btn" aria-label="Test connection to @instance.Name"><i class="ti ti-refresh" aria-hidden="true"></i>Test</button>
                        </form>
                        <partial name="_InstanceStatus" model="instance" />
                    </div>
                </div>
            }
            </div>
        }
    </div>
</div>

<div class="qf-card">
    <div class="qf-card-header">
        <h2>Storage paths</h2>
        <div class="d-flex align-items-center gap-2">
            @if (Model.StoragePaths.Count > 0)
            {
                <input type="search" class="form-control form-control-sm qf-table-filter"
                       data-table-filter placeholder="Filter&hellip;" aria-label="Filter storage paths" />
            }
            <a asp-page="/Instances/EditStoragePath" class="btn btn-sm btn-primary qf-ico-btn text-nowrap" aria-label="Add storage path"><i class="ti ti-plus" aria-hidden="true"></i><span class="d-none d-sm-inline">Add storage path</span></a>
        </div>
    </div>
    <div class="qf-card-body p-0">
        @if (Model.StoragePaths.Count == 0)
        {
            <partial name="_EmptyState" model='new EmptyStateModel("folder", "No storage paths monitored",
                "Add a folder or drive to watch its free space and use storage.<name>.* fields in rules.",
                "Add a storage path", Url.Page("/Instances/EditStoragePath"))' />
        }
        else
        {
            <div class="d-none d-md-block qf-table-wrap">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Enabled</th>
                        <th>Name</th>
                        <th>Path</th>
                        <th>Disk usage</th>
                        <th>Folder size</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var path in Model.StoragePaths)
                    {
                        var usage = Model.StorageUsage[path.Id];
                        <tr>
                            <td>
                                <form method="post" asp-page-handler="ToggleStoragePath" asp-route-id="@path.Id">
                                    <div class="form-check form-switch qf-toggle-switch">
                                        <input type="checkbox" class="form-check-input" role="switch"
                                               @(path.Enabled ? "checked" : "") onchange="this.form.submit()"
                                               aria-label="Enable @path.Name" />
                                    </div>
                                </form>
                            </td>
                            <td class="fw-medium">@path.Name</td>
                            <td class="qf-muted-mono text-secondary text-truncate" style="max-width: 260px;" title="@path.Path">@path.Path</td>
                            <td style="min-width: 12rem;"><partial name="_StorageUsage" model="usage" /></td>
                            <td><partial name="_FolderSize" model="(usage, path.FolderSizeScanIntervalMinutes)" /></td>
                            <td class="text-end text-nowrap">
                                <form method="post" asp-page-handler="ScanStorage" asp-route-id="@path.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary qf-ico-btn" aria-label="Scan @path.Name now"><i class="ti ti-scan" aria-hidden="true"></i>Scan now</button>
                                </form>
                                <a asp-page="/Instances/EditStoragePath" asp-route-id="@path.Id" class="btn btn-sm btn-outline-secondary qf-ico-btn"><i class="ti ti-pencil" aria-hidden="true"></i>Edit</a>
                                <form method="post" asp-page-handler="DeleteStoragePath" asp-route-id="@path.Id" class="d-inline"
                                      data-confirm="Delete storage path &quot;@path.Name&quot;? Rules using storage.@path.Name.* will fail to compile." data-confirm-ok="Delete">
                                    <button type="submit" class="btn btn-sm btn-outline-danger qf-ico-btn"><i class="ti ti-trash" aria-hidden="true"></i>Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-md-none qf-row-card-list">
            @foreach (var path in Model.StoragePaths)
            {
                var usage = Model.StorageUsage[path.Id];
                <div class="qf-row-card">
                    <div class="qf-row-card-top" style="padding-right: 0;">
                        <form method="post" asp-page-handler="ToggleStoragePath" asp-route-id="@path.Id">
                            <div class="form-check form-switch qf-toggle-switch">
                                <input type="checkbox" class="form-check-input" role="switch"
                                       @(path.Enabled ? "checked" : "") onchange="this.form.submit()"
                                       aria-label="Enable @path.Name" />
                            </div>
                        </form>
                        <span class="qf-row-card-title flex-grow-1">@path.Name</span>
                    </div>
                    <dl class="qf-row-card-meta">
                        <dt>Path</dt><dd class="qf-muted-mono text-secondary" title="@path.Path">@path.Path</dd>
                        <dt>Disk</dt><dd><partial name="_StorageUsage" model="usage" /></dd>
                        <dt>Folder</dt><dd><partial name="_FolderSize" model="(usage, path.FolderSizeScanIntervalMinutes)" /></dd>
                    </dl>
                    <div class="d-flex gap-2 mt-2">
                        <form method="post" asp-page-handler="ScanStorage" asp-route-id="@path.Id" class="flex-grow-1">
                            <button type="submit" class="btn btn-sm btn-outline-secondary qf-ico-btn w-100"><i class="ti ti-scan" aria-hidden="true"></i>Scan now</button>
                        </form>
                        <a asp-page="/Instances/EditStoragePath" asp-route-id="@path.Id" class="btn btn-sm btn-outline-secondary qf-ico-btn flex-grow-1"><i class="ti ti-pencil" aria-hidden="true"></i>Edit</a>
                        <form method="post" asp-page-handler="DeleteStoragePath" asp-route-id="@path.Id" class="flex-grow-1"
                              data-confirm="Delete storage path &quot;@path.Name&quot;? Rules using storage.@path.Name.* will fail to compile." data-confirm-ok="Delete">
                            <button type="submit" class="btn btn-sm btn-outline-danger qf-ico-btn w-100"><i class="ti ti-trash" aria-hidden="true"></i>Delete</button>
                        </form>
                    </div>
                </div>
            }
            </div>
        }
    </div>
</div>

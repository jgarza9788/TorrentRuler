@page "{id:int?}"
@model TorrentRuler.Web.Pages.Instances.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add instance" : "Edit instance";
}

@* Per-source-type help text. Every hint below is rendered server-side for the currently
   selected type first, then kept in sync by Alpine as the dropdown changes -- so the form is
   correct on first paint and without JavaScript. *@
<div id="qf-instance-guide-data" data-source-guide="@Model.SourceGuideJson" hidden></div>
<script>
    (function () {
        window.qfSourceGuide = JSON.parse(document.getElementById('qf-instance-guide-data').dataset.sourceGuide);
    })();
</script>

<div class="qf-card" style="max-width: 640px; margin: 0 auto;">
    <div class="qf-card-header">
        <h2>@(Model.IsNew ? "Add instance" : $"Edit instance: {Model.Input.Name}")</h2>
    </div>
    <div class="qf-card-body">
        <div asp-validation-summary="All" class="has-text-danger mb-3"></div>

        <form method="post"
              x-data="{ sourceType: '@Model.Input.SourceType', get guide() { return window.qfSourceGuide[this.sourceType]; } }">
            <input type="hidden" asp-for="Input.Id" />

            <div class="columns is-multiline is-variable is-3">
                <div class="column is-6-tablet">
                    <label asp-for="Input.Name" class="label"></label>
                    <input asp-for="Input.Name" class="input" />
                </div>
                <div class="column is-6-tablet">
                    <label asp-for="Input.SourceType" class="label"></label>
                    @* Options are built from the guide rather than GetEnumSelectList so their values are
                       enum names, which is what keys window.qfSourceGuide. Model binding accepts names. *@
                    <div class="select is-fullwidth">
                        <select asp-for="Input.SourceType" x-model="sourceType">
                            @foreach (var (value, label) in Model.SourceTypeOptions)
                            {
                                <option value="@value">@label</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="column is-12">
                    <label asp-for="Input.BaseUrl" class="label"></label>
                    <input asp-for="Input.BaseUrl" class="input"
                           placeholder="@Model.Guide.BaseUrlPlaceholder" :placeholder="guide.baseUrlPlaceholder" />
                    <div class="help" x-text="guide.baseUrl">@Model.Guide.BaseUrl</div>
                </div>

                <div class="column is-6-tablet">
                    <label asp-for="Input.Username" class="label"></label>
                    <input asp-for="Input.Username" class="input" autocomplete="off" />
                    <div class="help" x-text="guide.username">@Model.Guide.Username</div>
                </div>
                <div class="column is-6-tablet">
                    <label asp-for="Input.Password" class="label"></label>
                    <input asp-for="Input.Password" type="password" class="input" autocomplete="new-password"
                           placeholder="@(Model.Input.HasExistingPassword ? "Leave blank to keep existing" : "")" />
                    <div class="help" x-text="guide.password">@Model.Guide.Password</div>
                </div>
                <div class="column is-12">
                    <label asp-for="Input.ApiKey" class="label"></label>
                    <input asp-for="Input.ApiKey" type="password" class="input" autocomplete="new-password"
                           placeholder="@(Model.Input.HasExistingApiKey ? "Leave blank to keep existing" : "")" />
                    <div class="help" x-text="guide.apiKey">@Model.Guide.ApiKey</div>
                </div>

                <div class="column is-4-tablet">
                    <label asp-for="Input.TimeoutSeconds" class="label"></label>
                    <input asp-for="Input.TimeoutSeconds" type="number" class="input" />
                </div>
                <div class="column is-4-tablet is-flex is-align-items-end">
                    <div class="qf-check">
                        <input asp-for="Input.VerifySsl" />
                        <label asp-for="Input.VerifySsl"></label>
                    </div>
                </div>
                <div class="column is-4-tablet is-flex is-align-items-end">
                    <div class="qf-check">
                        <input asp-for="Input.Enabled" />
                        <label asp-for="Input.Enabled"></label>
                    </div>
                </div>

                <div class="column is-12">
                    <label asp-for="Input.ExtraConfigJson" class="label"></label>
                    <textarea asp-for="Input.ExtraConfigJson" class="textarea qf-muted-mono" rows="3"
                              placeholder="@Model.Guide.ExtraConfigPlaceholder"
                              :placeholder="guide.extraConfigPlaceholder"></textarea>
                    <div class="help" x-text="guide.extraConfig">@Model.Guide.ExtraConfig</div>
                </div>
            </div>

            <div class="mt-4 is-flex is-gap-2 is-align-items-center">
                <button type="submit" class="button is-primary qf-ico-btn"><i class="ti ti-device-floppy" aria-hidden="true"></i>Save</button>
                <a asp-page="/Instances/Index" class="button">Cancel</a>
                <button type="button" class="button ms-auto qf-ico-btn"
                        hx-post="?handler=TestConnection" hx-include="closest form"
                        hx-target="#edit-conn-test-result" hx-swap="innerHTML"
                        hx-indicator="#edit-conn-test-spinner"><i class="ti ti-refresh" aria-hidden="true"></i>Test connection</button>
                <span id="edit-conn-test-spinner" class="htmx-indicator small text-secondary qf-ico-btn">
                    <span class="qf-spinner" role="status" aria-hidden="true"></span>testing&hellip;
                </span>
            </div>
            <div id="edit-conn-test-result" class="mt-2"></div>
            <div class="help">Tests the values entered above (leave the password / API key blank to reuse the saved one).</div>
        </form>
    </div>
</div>

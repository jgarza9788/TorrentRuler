@page "{id:int?}"
@model TorrentRuler.Web.Pages.Instances.EditStoragePathModel
@{
    ViewData["Title"] = Model.IsNew ? "Add storage path" : "Edit storage path";
}

<div class="qf-card" style="max-width: 560px;">
    <div class="qf-card-header">
        <h2>@(Model.IsNew ? "Add storage path" : $"Edit storage path: {Model.Input.Name}")</h2>
    </div>
    <div class="qf-card-body">
        <div asp-validation-summary="All" class="has-text-danger mb-3"></div>

        <form method="post">
            <input type="hidden" asp-for="Input.Id" />

            <div class="columns is-multiline is-variable is-3">
                <div class="column is-5-tablet">
                    <label asp-for="Input.Name" class="label"></label>
                    <input asp-for="Input.Name" class="input" placeholder="downloads" />
                    <div class="help">Referenced in rules as <code>storage.@("{name}")​.used_percent</code>, etc.</div>
                </div>
                <div class="column is-7-tablet">
                    <label asp-for="Input.Path" class="label"></label>
                    <input asp-for="Input.Path" class="input qf-muted-mono" placeholder="/downloads" />
                </div>
                <div class="column is-6-tablet">
                    <label asp-for="Input.FolderSizeScanIntervalMinutes" class="label"></label>
                    <input asp-for="Input.FolderSizeScanIntervalMinutes" type="number" class="input" />
                </div>
                <div class="column is-6-tablet is-flex is-align-items-end">
                    <div class="qf-check">
                        <input asp-for="Input.Enabled" />
                        <label asp-for="Input.Enabled"></label>
                    </div>
                </div>
            </div>

            <div class="mt-4 is-flex is-gap-2">
                <button type="submit" class="button is-primary qf-ico-btn"><i class="ti ti-device-floppy" aria-hidden="true"></i>Save</button>
                <a asp-page="/Instances/Index" class="button">Cancel</a>
            </div>
        </form>
    </div>
</div>

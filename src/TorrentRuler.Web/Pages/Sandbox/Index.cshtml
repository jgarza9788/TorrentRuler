@page
@model TorrentRuler.Web.Pages.Sandbox.IndexModel
@{
    ViewData["Title"] = "SQL sandbox";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">SQL sandbox</h1>
    <span class="text-muted small">Read-only, against the current snapshot.</span>
</div>

<div class="row g-3">
    <div class="col-lg-3">
        <div class="qf-card">
            <div class="qf-card-body">
                <h2 class="h6">Tables</h2>
                @foreach (var t in Model.Tables)
                {
                    <details class="mb-1">
                        <summary><code>@t.Name</code> <span class="text-muted small">(@t.RowCount)</span></summary>
                        <div class="small ps-3">
                            @foreach (var c in t.Columns)
                            {
                                <div><code>@c</code></div>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>
        <div class="qf-card mt-3">
            <div class="qf-card-body">
                <h2 class="h6">Helper functions</h2>
                <div class="text-muted small mb-2">Click one to insert it into the query.</div>
                @foreach (var h in Model.Helpers)
                {
                    <button type="button" class="btn btn-link p-0 text-start d-block text-decoration-none mb-2"
                            data-insert="@h.Signature" title="Insert into the query">
                        <code>@h.Signature</code>
                        <span class="d-block small text-secondary">@h.Description</span>
                    </button>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-9">
        <form method="post">
            <textarea asp-for="Sql" class="form-control font-monospace mb-2" rows="8" spellcheck="false"
                      onkeydown="if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') { this.form.requestSubmit(); }"></textarea>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary btn-sm qf-ico-btn"><i class="ti ti-player-play" aria-hidden="true"></i>Run (Ctrl+Enter)</button>
                <button type="button" class="btn btn-outline-secondary btn-sm qf-ico-btn" id="useAsRule"
                        title="Start a new rule with this query as its condition"><i class="ti ti-filter-plus" aria-hidden="true"></i>Use as rule</button>
            </div>
            <div class="form-text">A rule's query must return <code>instance_id</code> and <code>torrent_hash</code>.</div>
        </form>

        @if (Model.Error is not null)
        {
            <div class="alert alert-danger mt-3">@Model.Error</div>
        }
        else if (Model.Ran)
        {
            <div class="text-muted small mt-3 mb-1">
                @Model.Rows.Count row(s) in @Model.ElapsedMs ms@(Model.Truncated ? $" — truncated to {TorrentRuler.Web.Pages.Sandbox.IndexModel.MaxRows}" : "")
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-striped font-monospace small">
                    <thead><tr>@foreach (var c in Model.Columns) { <th>@c</th> }</tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>@foreach (var v in row) { <td>@(v is null ? "NULL" : v.ToString())</td> }</tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // "Use as rule": a new rule in advanced mode, prefilled with the current query.
        document.getElementById('useAsRule')?.addEventListener('click', () => {
            location.href = '/Rules/Edit?sql=' + encodeURIComponent(document.getElementById('Sql').value);
        });

        // Insert a helper's signature at the cursor (replacing any selection) in the query box.
        document.addEventListener('click', e => {
            const btn = e.target.closest('[data-insert]');
            if (!btn) return;
            const box = document.getElementById('Sql');
            const text = btn.getAttribute('data-insert');
            const start = box.selectionStart ?? box.value.length;
            const end = box.selectionEnd ?? start;
            box.setRangeText(text, start, end, 'end');
            box.focus();
        });
    </script>
}

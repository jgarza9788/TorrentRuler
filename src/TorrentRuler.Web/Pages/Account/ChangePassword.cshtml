@page
@model TorrentRuler.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<h1 class="title is-4 mb-3">Change password</h1>

<div class="column is-4-tablet p-0">
    @if (Model.Success)
    {
        <div class="notification is-success is-light">Password changed.</div>
    }

    <div asp-validation-summary="All" class="has-text-danger"></div>

    <form method="post">
        <div class="field mb-3">
            <label asp-for="Input.CurrentPassword" class="label"></label>
            <div class="control">
                <input asp-for="Input.CurrentPassword" type="password" class="input" autocomplete="current-password" />
            </div>
        </div>
        <div class="field mb-3">
            <label asp-for="Input.NewPassword" class="label"></label>
            <div class="control">
                <input asp-for="Input.NewPassword" type="password" class="input" autocomplete="new-password" />
            </div>
        </div>
        <div class="field mb-3">
            <label asp-for="Input.ConfirmNewPassword" class="label"></label>
            <div class="control">
                <input asp-for="Input.ConfirmNewPassword" type="password" class="input" autocomplete="new-password" />
            </div>
        </div>
        <button type="submit" class="button is-primary qf-ico-btn"><i class="ti ti-key" aria-hidden="true"></i>Change password</button>
    </form>
</div>

@page
@using TorrentRuler.Infrastructure.Config
@using TorrentRuler.Web.Pages.Shared
@model TorrentRuler.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="qf-card mb-4">
            <div class="qf-card-header">
                <h2>General</h2>
            </div>
            <div class="qf-card-body">
                <form method="post" asp-page-handler="SaveSettings" id="settingsForm">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.ParallelismLevel" class="form-label"></label>
                            <select asp-for="Input.ParallelismLevel" class="form-select">
                                @foreach (var (level, label) in TorrentRuler.Web.Pages.Settings.IndexModel.ParallelismOptions)
                                {
                                    <option value="@level" selected="@(Model.Input.ParallelismLevel == level)">@label</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.TimeZoneId" class="form-label"></label>
                            <input asp-for="Input.TimeZoneId" class="form-control" placeholder="UTC" />
                            <div class="form-text">Default timezone for new rules, e.g. UTC or America/New_York.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Theme" class="form-label"></label>
                            <select asp-for="Input.Theme" class="form-select">
                                <option value="system">Match system</option>
                                <option value="light">Light</option>
                                <option value="dark">Dark</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.LogLevel" class="form-label"></label>
                            <select asp-for="Input.LogLevel" class="form-select">
                                <option>Trace</option>
                                <option>Debug</option>
                                <option>Information</option>
                                <option>Warning</option>
                                <option>Error</option>
                                <option>Critical</option>
                            </select>
                            <div class="form-text">Applied immediately to the <code>/log</code> files and the console stream on save &mdash; no restart.</div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary qf-ico-btn"><i class="ti ti-device-floppy" aria-hidden="true"></i>Save settings</button>
                    </div>
                </form>
            </div>
        </div>

        @* Same form as General (form="settingsForm"), split out so the two global overrides can't be missed. *@
        <div class="qf-card qf-danger-zone mb-4" x-data="{ dry: @(Model.Input.GlobalDryRun ? "true" : "false"), kill: @(Model.Input.GlobalKillSwitch ? "true" : "false") }">
            <div class="qf-card-header">
                <h2 class="text-danger"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Danger zone</h2>
            </div>
            <div class="qf-card-body">
                <div class="qf-danger-row">
                    <div class="form-check form-switch mb-0">
                        <input asp-for="Input.GlobalDryRun" form="settingsForm" class="form-check-input" role="switch" x-model="dry" aria-describedby="dryRunExplain" />
                        <label asp-for="Input.GlobalDryRun" class="form-check-label fw-medium">Global dry run</label>
                    </div>
                    <span class="qf-badge" :class="dry ? 'qf-badge-warning' : 'qf-badge-secondary'" x-text="dry ? 'ON' : 'OFF'">@(Model.Input.GlobalDryRun ? "ON" : "OFF")</span>
                    <div class="form-text w-100" id="dryRunExplain">Every rule previews its actions instead of applying them. Runs still happen and are recorded.</div>
                </div>
                <hr />
                <div class="qf-danger-row">
                    <div class="form-check form-switch mb-0">
                        <input asp-for="Input.GlobalKillSwitch" form="settingsForm" class="form-check-input" role="switch" x-model="kill" aria-describedby="killExplain"
                               @@change="if (kill && !confirm('Turn the kill switch on? No rule will run until you turn it off again.')) { kill = false; }" />
                        <label asp-for="Input.GlobalKillSwitch" class="form-check-label fw-medium">Kill switch</label>
                    </div>
                    <span class="qf-badge" :class="kill ? 'qf-badge-danger' : 'qf-badge-secondary'" x-text="kill ? 'ON' : 'OFF'">@(Model.Input.GlobalKillSwitch ? "ON" : "OFF")</span>
                    <div class="form-text w-100" id="killExplain">Stops all rules from running, on schedule or by Run now.</div>
                </div>
                <div class="small text-secondary mt-3">Takes effect when you press <strong>Save settings</strong> above.</div>
            </div>
        </div>

        <div class="qf-card">
            <div class="qf-card-header">
                <h2>Path mappings</h2>
                <a asp-page="/Settings/EditPathMapping" class="btn btn-sm btn-primary qf-ico-btn text-nowrap" aria-label="Add mapping"><i class="ti ti-plus" aria-hidden="true"></i><span class="d-none d-sm-inline">Add mapping</span></a>
            </div>
            <div class="qf-card-body p-0">
                @if (Model.PathMappingRules.Count == 0)
                {
                    <partial name="_EmptyState" model='new EmptyStateModel("route", "No path mappings",
                        "Only needed when qBittorrent and your media server mount the same files at different paths (e.g. /downloads vs /media).",
                        "Add a mapping", Url.Page("/Settings/EditPathMapping"))' />
                }
                else
                {
                    <div class="d-none d-md-block qf-table-wrap">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                            <tr><th>Status</th><th>Source prefix</th><th></th><th>Canonical prefix</th><th class="text-end">Actions</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var rule in Model.PathMappingRules)
                            {
                                <tr>
                                    <td>
                                        <form method="post" asp-page-handler="TogglePathMapping" asp-route-id="@rule.Id">
                                            <div class="form-check form-switch qf-toggle-switch">
                                                <input type="checkbox" class="form-check-input" role="switch"
                                                       @(rule.Enabled ? "checked" : "") onchange="this.form.submit()"
                                                       aria-label="Toggle @rule.SourcePrefix" />
                                            </div>
                                        </form>
                                    </td>
                                    <td class="qf-muted-mono text-truncate" style="max-width: 200px;" title="@rule.SourcePrefix">@rule.SourcePrefix</td>
                                    <td class="text-secondary">&rarr;</td>
                                    <td class="qf-muted-mono text-truncate" style="max-width: 200px;" title="@rule.CanonicalPrefix">@rule.CanonicalPrefix</td>
                                    <td class="text-end">
                                        <a asp-page="/Settings/EditPathMapping" asp-route-id="@rule.Id" class="btn btn-sm btn-outline-secondary qf-ico-btn"><i class="ti ti-pencil" aria-hidden="true"></i>Edit</a>
                                        <form method="post" asp-page-handler="DeletePathMapping" asp-route-id="@rule.Id" class="d-inline"
                                              data-confirm="Delete path mapping &quot;@rule.SourcePrefix&quot; → &quot;@rule.CanonicalPrefix&quot;?" data-confirm-ok="Delete">
                                            <button type="submit" class="btn btn-sm btn-outline-danger qf-ico-btn"><i class="ti ti-trash" aria-hidden="true"></i>Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-md-none qf-row-card-list">
                    @foreach (var rule in Model.PathMappingRules)
                    {
                        <div class="qf-row-card">
                            <div class="qf-row-card-top" style="padding-right: 0;">
                                <form method="post" asp-page-handler="TogglePathMapping" asp-route-id="@rule.Id">
                                    <div class="form-check form-switch qf-toggle-switch">
                                        <input type="checkbox" class="form-check-input" role="switch"
                                               @(rule.Enabled ? "checked" : "") onchange="this.form.submit()"
                                               aria-label="Toggle @rule.SourcePrefix" />
                                    </div>
                                </form>
                                <span class="qf-row-card-title flex-grow-1 qf-muted-mono" title="@rule.SourcePrefix">@rule.SourcePrefix</span>
                            </div>
                            <dl class="qf-row-card-meta">
                                <dt>Canonical</dt><dd class="qf-muted-mono" title="@rule.CanonicalPrefix">@rule.CanonicalPrefix</dd>
                            </dl>
                            <div class="d-flex gap-2 mt-2">
                                <a asp-page="/Settings/EditPathMapping" asp-route-id="@rule.Id" class="btn btn-sm btn-outline-secondary qf-ico-btn flex-grow-1"><i class="ti ti-pencil" aria-hidden="true"></i>Edit</a>
                                <form method="post" asp-page-handler="DeletePathMapping" asp-route-id="@rule.Id" class="flex-grow-1"
                                      data-confirm="Delete path mapping &quot;@rule.SourcePrefix&quot; → &quot;@rule.CanonicalPrefix&quot;?" data-confirm-ok="Delete">
                                    <button type="submit" class="btn btn-sm btn-outline-danger qf-ico-btn w-100"><i class="ti ti-trash" aria-hidden="true"></i>Delete</button>
                                </form>
                            </div>
                        </div>
                    }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="qf-card">
            <div class="qf-card-header">
                <h2>Config import / export</h2>
            </div>
            <div class="qf-card-body">
                @if (Model.ImportError is not null)
                {
                    <div class="alert alert-danger py-2">@Model.ImportError</div>
                }

                <h3 class="h6">Export</h3>
                <p class="text-secondary small">Instance credentials are never included in an export.</p>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <a class="btn btn-sm btn-outline-secondary qf-ico-btn" asp-page-handler="ExportConfig" asp-route-format="Json"><i class="ti ti-download" aria-hidden="true"></i>Config (JSON)</a>
                    <a class="btn btn-sm btn-outline-secondary qf-ico-btn" asp-page-handler="ExportConfig" asp-route-format="Yaml"><i class="ti ti-download" aria-hidden="true"></i>Config (YAML)</a>
                    <a class="btn btn-sm btn-outline-secondary qf-ico-btn" asp-page-handler="ExportRules" asp-route-format="Json"><i class="ti ti-download" aria-hidden="true"></i>Rules (JSON)</a>
                    <a class="btn btn-sm btn-outline-secondary qf-ico-btn" asp-page-handler="ExportRules" asp-route-format="Yaml"><i class="ti ti-download" aria-hidden="true"></i>Rules (YAML)</a>
                </div>

                <hr>

                <h3 class="h6">Import</h3>
                @if (Model.Preview is { } preview)
                {
                    <div id="importPreview">
                        @if (preview.Error is not null)
                        {
                            <div class="alert alert-danger py-2 qf-cell-wrap">@preview.Error</div>
                            <a asp-page="/Settings/Index" class="btn btn-sm btn-outline-secondary">Choose another file</a>
                        }
                        else
                        {
                            var adds = preview.Changes.Count(c => c.Kind == ImportChangeKind.Add);
                            var updates = preview.Changes.Count(c => c.Kind == ImportChangeKind.Update);
                            <p class="small mb-2">
                                This @(Model.PreviewKind == "rules" ? "rules" : "config") file would add <strong>@adds</strong> and update <strong>@updates</strong> item(s);
                                @preview.Changes.Count(c => c.Kind == ImportChangeKind.Unchanged) unchanged. Nothing has been changed yet.
                            </p>
                            <div class="qf-table-wrap qf-import-diff mb-2">
                                <table class="table table-sm align-middle mb-0">
                                    <thead><tr><th>Item</th><th>Change</th></tr></thead>
                                    <tbody>
                                    @foreach (var c in preview.Changes.OrderBy(c => c.Kind == ImportChangeKind.Unchanged).ThenBy(c => c.Section))
                                    {
                                        <tr class="@(c.Kind == ImportChangeKind.Unchanged ? "qf-row-muted" : null)">
                                            <td><span class="text-secondary small">@c.Section</span> <span class="fw-medium">@c.Name</span></td>
                                            <td>
                                                @switch (c.Kind)
                                                {
                                                    case ImportChangeKind.Add: <span class="qf-badge qf-badge-success">add</span> break;
                                                    case ImportChangeKind.Update: <span class="qf-badge qf-badge-warning">update</span> <span class="small text-secondary">@string.Join(", ", c.ChangedFields)</span> break;
                                                    default: <span class="small text-secondary">unchanged</span> break;
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            <form method="post" asp-page-handler="ImportConfig" class="d-flex gap-2">
                                <textarea name="importContent" hidden>@Model.PreviewContent</textarea>
                                <input type="hidden" name="importFormat" value="@Model.PreviewFormat" />
                                <input type="hidden" name="importKind" value="@Model.PreviewKind" />
                                <button type="submit" class="btn btn-sm btn-primary qf-ico-btn" disabled="@(!preview.HasChanges)"><i class="ti ti-check" aria-hidden="true"></i>Apply import</button>
                                <a asp-page="/Settings/Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
                            </form>
                        }
                    </div>
                }
                else
                {
                    <form method="post" asp-page-handler="PreviewImport" enctype="multipart/form-data">
                        <div class="mb-2">
                            <label class="form-label small mb-1" for="importKind">What's in the file</label>
                            <select name="importKind" id="importKind" class="form-select form-select-sm">
                                <option value="config">Config (instances, storage paths, settings)</option>
                                <option value="rules">Rules</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small mb-1" for="importFormat">Format</label>
                            <select name="importFormat" id="importFormat" class="form-select form-select-sm">
                                <option value="Json">JSON</option>
                                <option value="Yaml">YAML</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small mb-1" for="importFile">File</label>
                            <input type="file" name="importFile" id="importFile" class="form-control form-control-sm" accept=".json,.yaml,.yml" />
                        </div>
                        <button type="submit" class="btn btn-sm btn-outline-primary qf-ico-btn"><i class="ti ti-eye" aria-hidden="true"></i>Preview import</button>
                        <div class="form-text">You'll see what would be added or changed before anything is applied.</div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="qf-card">
            <div class="qf-card-header">
                <h2>Info</h2>
                <button type="button" class="btn btn-sm btn-outline-secondary qf-ico-btn" id="copyDiagnostics"
                        data-copy-text="@Model.Diagnostics"><i class="ti ti-clipboard" aria-hidden="true"></i>Copy diagnostics</button>
            </div>
            <div class="qf-card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5 text-secondary fw-normal">Branch</dt>
                    <dd class="col-7 qf-muted-mono text-truncate mb-2" title="@Model.GitBranch">@Model.GitBranch</dd>

                    <dt class="col-5 text-secondary fw-normal">Commit</dt>
                    <dd class="col-7 qf-muted-mono mb-2">@Model.GitCommit</dd>

                    <dt class="col-5 text-secondary fw-normal">Built</dt>
                    <dd class="col-7 mb-2">
                        @if (Model.BuildTimeUtc is not null)
                        {
                            <partial name="_RelativeTime" model="new DateTimeOffset(Model.BuildTimeUtc.Value, TimeSpan.Zero)" />
                        }
                        else
                        {
                            <span>unknown</span>
                        }
                    </dd>

                    <dt class="col-5 text-secondary fw-normal">.NET runtime</dt>
                    <dd class="col-7 mb-2">@Model.RuntimeVersion</dd>

                    <dt class="col-5 text-secondary fw-normal">Environment</dt>
                    <dd class="col-7 mb-0">@Model.EnvironmentName</dd>
                </dl>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Diagnostics include the browser, which only the browser knows.
        (function () {
            var b = document.getElementById('copyDiagnostics');
            if (b) b.setAttribute('data-copy-text', b.getAttribute('data-copy-text') + '\nBrowser: ' + navigator.userAgent);
        })();
    </script>
}

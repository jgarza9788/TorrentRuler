@page
@model TorrentRuler.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
}

<div class="columns is-multiline is-variable is-4">
    <div class="column is-7-desktop">
        <div class="qf-card mb-4">
            <div class="qf-card-header">
                <h2>General</h2>
            </div>
            <div class="qf-card-body">
                @if (Model.SettingsSaved)
                {
                    <div class="notification is-success is-light py-2">Settings saved.</div>
                }
                <form method="post" asp-page-handler="SaveSettings">
                    <div class="columns is-multiline is-variable is-3">
                        <div class="column is-6-tablet">
                            <label asp-for="Input.ParallelismLevel" class="label"></label>
                            <div class="select is-fullwidth">
                                <select asp-for="Input.ParallelismLevel" asp-items="Html.GetEnumSelectList<TorrentRuler.Core.Domain.ParallelismLevel>()"></select>
                            </div>
                            <div class="help">Low=2, Medium=4, High=8, Very High=16 concurrent requests per host.</div>
                        </div>
                        <div class="column is-6-tablet">
                            <label asp-for="Input.TimeZoneId" class="label"></label>
                            <input asp-for="Input.TimeZoneId" class="input" placeholder="UTC" />
                            <div class="help">Default timezone for new rules, e.g. UTC or America/New_York.</div>
                        </div>
                        <div class="column is-6-tablet">
                            <label asp-for="Input.Theme" class="label"></label>
                            <div class="select is-fullwidth">
                                <select asp-for="Input.Theme">
                                    <option value="system">Match system</option>
                                    <option value="light">Light</option>
                                    <option value="dark">Dark</option>
                                </select>
                            </div>
                        </div>
                        <div class="column is-6-tablet">
                            <label asp-for="Input.LogLevel" class="label"></label>
                            <div class="select is-fullwidth">
                                <select asp-for="Input.LogLevel">
                                    <option>Trace</option>
                                    <option>Debug</option>
                                    <option>Information</option>
                                    <option>Warning</option>
                                    <option>Error</option>
                                    <option>Critical</option>
                                </select>
                            </div>
                            <div class="help">Applied immediately to the <code>/log</code> files and the console stream on save &mdash; no restart.</div>
                        </div>
                        <div class="column is-12">
                            <hr />
                        </div>
                        <div class="column is-12">
                            <div class="qf-check">
                                <span class="qf-toggle-switch"><input asp-for="Input.GlobalDryRun" role="switch" /></span>
                                <label asp-for="Input.GlobalDryRun"></label>
                            </div>
                        </div>
                        <div class="column is-12">
                            <div class="qf-check">
                                <span class="qf-toggle-switch"><input asp-for="Input.GlobalKillSwitch" role="switch" /></span>
                                <label asp-for="Input.GlobalKillSwitch" class="has-text-danger"></label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="button is-primary qf-ico-btn"><i class="ti ti-device-floppy" aria-hidden="true"></i>Save settings</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="qf-card">
            <div class="qf-card-header">
                <h2>Path mappings</h2>
                <a asp-page="/Settings/EditPathMapping" class="button is-small is-primary qf-ico-btn text-nowrap" aria-label="Add mapping"><i class="ti ti-plus" aria-hidden="true"></i><span class="is-hidden-mobile">Add mapping</span></a>
            </div>
            <div class="qf-card-body p-0">
                @if (Model.PathMappingRules.Count == 0)
                {
                    <div class="qf-empty">
                        <p class="mb-0">No path mappings configured. Only needed if your qBittorrent and media-server containers mount the same files at different paths.</p>
                    </div>
                }
                else
                {
                    <div class="is-hidden-touch table-container">
                        <table class="table is-narrow align-middle mb-0">
                            <thead>
                            <tr><th>Status</th><th>Source prefix</th><th></th><th>Canonical prefix</th><th class="has-text-right">Actions</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var rule in Model.PathMappingRules)
                            {
                                <tr>
                                    <td>
                                        <form method="post" asp-page-handler="TogglePathMapping" asp-route-id="@rule.Id">
                                            <div class="qf-toggle-switch">
                                                <input type="checkbox" role="switch"
                                                       @(rule.Enabled ? "checked" : "") onchange="this.form.submit()"
                                                       aria-label="Toggle @rule.SourcePrefix" />
                                            </div>
                                        </form>
                                    </td>
                                    <td class="qf-muted-mono text-truncate" style="max-width: 200px;" title="@rule.SourcePrefix">@rule.SourcePrefix</td>
                                    <td class="text-secondary">&rarr;</td>
                                    <td class="qf-muted-mono text-truncate" style="max-width: 200px;" title="@rule.CanonicalPrefix">@rule.CanonicalPrefix</td>
                                    <td class="has-text-right">
                                        <a asp-page="/Settings/EditPathMapping" asp-route-id="@rule.Id" class="button is-small qf-ico-btn"><i class="ti ti-pencil" aria-hidden="true"></i>Edit</a>
                                        <form method="post" asp-page-handler="DeletePathMapping" asp-route-id="@rule.Id" class="is-inline-block"
                                              onsubmit="return confirm('Delete path mapping &quot;@rule.SourcePrefix&quot;?');">
                                            <button type="submit" class="button is-small is-danger is-light qf-ico-btn"><i class="ti ti-trash" aria-hidden="true"></i>Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="is-hidden-desktop qf-row-card-list">
                    @foreach (var rule in Model.PathMappingRules)
                    {
                        <div class="qf-row-card">
                            <div class="qf-row-card-top" style="padding-right: 0;">
                                <form method="post" asp-page-handler="TogglePathMapping" asp-route-id="@rule.Id">
                                    <div class="qf-toggle-switch">
                                        <input type="checkbox" role="switch"
                                               @(rule.Enabled ? "checked" : "") onchange="this.form.submit()"
                                               aria-label="Toggle @rule.SourcePrefix" />
                                    </div>
                                </form>
                                <span class="qf-row-card-title is-flex-grow-1 qf-muted-mono" title="@rule.SourcePrefix">@rule.SourcePrefix</span>
                            </div>
                            <dl class="qf-row-card-meta">
                                <dt>Canonical</dt><dd class="qf-muted-mono" title="@rule.CanonicalPrefix">@rule.CanonicalPrefix</dd>
                            </dl>
                            <div class="is-flex is-gap-2 mt-2">
                                <a asp-page="/Settings/EditPathMapping" asp-route-id="@rule.Id" class="button is-small qf-ico-btn is-flex-grow-1"><i class="ti ti-pencil" aria-hidden="true"></i>Edit</a>
                                <form method="post" asp-page-handler="DeletePathMapping" asp-route-id="@rule.Id" class="is-flex-grow-1"
                                      onsubmit="return confirm('Delete path mapping &quot;@rule.SourcePrefix&quot;?');">
                                    <button type="submit" class="button is-small is-danger is-light qf-ico-btn is-fullwidth"><i class="ti ti-trash" aria-hidden="true"></i>Delete</button>
                                </form>
                            </div>
                        </div>
                    }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="column is-5-desktop">
        <div class="qf-card">
            <div class="qf-card-header">
                <h2>Config import / export</h2>
            </div>
            <div class="qf-card-body">
                @if (Model.ImportError is not null)
                {
                    <div class="notification is-danger is-light py-2">@Model.ImportError</div>
                }
                @if (Model.ImportSuccess is not null)
                {
                    <div class="notification is-success is-light py-2">@Model.ImportSuccess</div>
                }

                <h3 class="title is-6">Export</h3>
                <p class="text-secondary small">Instance credentials are never included in an export.</p>
                <div class="is-flex is-flex-wrap-wrap is-gap-2 mb-4">
                    <a class="button is-small qf-ico-btn" asp-page-handler="ExportConfig" asp-route-format="Json"><i class="ti ti-download" aria-hidden="true"></i>Config (JSON)</a>
                    <a class="button is-small qf-ico-btn" asp-page-handler="ExportConfig" asp-route-format="Yaml"><i class="ti ti-download" aria-hidden="true"></i>Config (YAML)</a>
                    <a class="button is-small qf-ico-btn" asp-page-handler="ExportRules" asp-route-format="Json"><i class="ti ti-download" aria-hidden="true"></i>Rules (JSON)</a>
                    <a class="button is-small qf-ico-btn" asp-page-handler="ExportRules" asp-route-format="Yaml"><i class="ti ti-download" aria-hidden="true"></i>Rules (YAML)</a>
                </div>

                <hr>

                <h3 class="title is-6">Import</h3>
                <form method="post" asp-page-handler="ImportConfig" enctype="multipart/form-data">
                    <div class="mb-2">
                        <div class="select is-small is-fullwidth">
                            <select name="importKind">
                                <option value="config">Config (instances + settings)</option>
                                <option value="rules">Rules</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="select is-small is-fullwidth">
                            <select name="importFormat">
                                <option value="Json">JSON</option>
                                <option value="Yaml">YAML</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-2">
                        <input type="file" name="importFile" accept=".json,.yaml,.yml" />
                    </div>
                    <button type="submit" class="button is-small is-primary is-light qf-ico-btn"><i class="ti ti-upload" aria-hidden="true"></i>Import</button>
                </form>
            </div>
        </div>
    </div>

    <div class="column is-5-desktop">
        <div class="qf-card">
            <div class="qf-card-header">
                <h2>Info</h2>
            </div>
            <div class="qf-card-body">
                <dl class="columns is-mobile is-multiline mb-0 small">
                    <dt class="column is-5 text-secondary has-text-weight-normal">Branch</dt>
                    <dd class="column is-7 qf-muted-mono text-truncate mb-2" title="@Model.GitBranch">@Model.GitBranch</dd>

                    <dt class="column is-5 text-secondary has-text-weight-normal">Commit</dt>
                    <dd class="column is-7 qf-muted-mono mb-2">@Model.GitCommit</dd>

                    <dt class="column is-5 text-secondary has-text-weight-normal">Built</dt>
                    <dd class="column is-7 mb-2">
                        @if (Model.BuildTimeUtc is not null)
                        {
                            <partial name="_RelativeTime" model="new DateTimeOffset(Model.BuildTimeUtc.Value, TimeSpan.Zero)" />
                        }
                        else
                        {
                            <span>unknown</span>
                        }
                    </dd>

                    <dt class="column is-5 text-secondary has-text-weight-normal">.NET runtime</dt>
                    <dd class="column is-7 mb-2">@Model.RuntimeVersion</dd>

                    <dt class="column is-5 text-secondary has-text-weight-normal">Environment</dt>
                    <dd class="column is-7 mb-0">@Model.EnvironmentName</dd>
                </dl>
            </div>
        </div>
    </div>

</div>

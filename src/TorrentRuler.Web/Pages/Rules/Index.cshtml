@page
@model TorrentRuler.Web.Pages.Rules.IndexModel
@{
    ViewData["Title"] = "Rules";
}

<div class="qf-card">
    <div class="qf-card-header">
        <h2>Rules</h2>
        <div class="is-flex is-align-items-center is-gap-2">
            @if (Model.Rules.Count > 0)
            {
                <input type="search" class="input is-small qf-table-filter"
                       data-table-filter placeholder="Filter&hellip;" aria-label="Filter rules" />
            }
            <a asp-page="/Rules/Edit" class="button is-small is-primary qf-ico-btn text-nowrap" aria-label="Add rule"><i class="ti ti-plus" aria-hidden="true"></i><span class="is-hidden-mobile">Add rule</span></a>
        </div>
    </div>
    <div class="qf-card-body p-0">
        @if (Model.Rules.Count == 0)
        {
            <div class="qf-empty">
                <div class="qf-empty-icon ti ti-checklist" aria-hidden="true"></div>
                <p class="mb-2">No rules yet. A rule is a schedule, a condition, and one or more actions.</p>
                <a asp-page="/Rules/Edit" class="button is-small is-primary qf-ico-btn"><i class="ti ti-plus" aria-hidden="true"></i>Create your first rule</a>
            </div>
        }
        else
        {
            <div class="is-hidden-touch table-container">
                <table class="table is-narrow align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Status</th>
                        <th class="is-hidden-touch">Priority</th>
                        <th>Name</th>
                        <th>Schedule</th>
                        <th>Last run</th>
                        <th class="has-text-right">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var rule in Model.Rules)
                    {
                        <tr>
                            <td>
                                <form method="post" asp-page-handler="ToggleEnabled" asp-route-id="@rule.Id">
                                    <div class="qf-toggle-switch">
                                        <input type="checkbox" role="switch"
                                               @(rule.Enabled ? "checked" : "") onchange="this.form.submit()"
                                               aria-label="Toggle @rule.Name" />
                                    </div>
                                </form>
                            </td>
                            <td class="text-secondary is-hidden-touch">@rule.Priority</td>
                            <td>
                                <div class="has-text-weight-medium">@rule.Name</div>
                                @if (!string.IsNullOrEmpty(rule.Description))
                                {
                                    <div class="small text-secondary">@rule.Description</div>
                                }
                                @if (rule.DryRun)
                                {
                                    <span class="qf-badge qf-badge-secondary">dry-run</span>
                                }
                            </td>
                            <td class="small" style="max-width: 240px;">
                                @TorrentRuler.Engine.Scheduling.CronDescriptionService.Describe(rule.CronExpression)
                                <div class="qf-muted-mono text-truncate" title="@rule.CronExpression (@rule.TimeZoneId)">@rule.CronExpression (@rule.TimeZoneId)</div>
                            </td>
                            <td class="text-secondary small">
                                @if (rule.LastRunAt is not null)
                                {
                                    <partial name="_RelativeTime" model="rule.LastRunAt.Value" />
                                }
                                else
                                {
                                    <span>never</span>
                                }
                            </td>
                            <td class="has-text-right">
                                <form method="post" asp-page-handler="RunNow" asp-route-id="@rule.Id" class="is-inline-block">
                                    <button type="submit" class="button is-small is-success is-light qf-ico-btn"><i class="ti ti-player-play" aria-hidden="true"></i>Run now</button>
                                </form>
                                <a asp-page="/Rules/Edit" asp-route-id="@rule.Id" class="button is-small qf-ico-btn"><i class="ti ti-pencil" aria-hidden="true"></i>Edit</a>
                                <form method="post" asp-page-handler="Duplicate" asp-route-id="@rule.Id" class="is-inline-block">
                                    <button type="submit" class="button is-small qf-ico-btn"><i class="ti ti-clipboard" aria-hidden="true"></i>Duplicate</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@rule.Id" class="is-inline-block"
                                      onsubmit="return confirm('Delete rule &quot;@rule.Name&quot;?');">
                                    <button type="submit" class="button is-small is-danger is-light qf-ico-btn"><i class="ti ti-trash" aria-hidden="true"></i>Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="is-hidden-desktop qf-row-card-list">
            @foreach (var rule in Model.Rules)
            {
                <div class="qf-row-card">
                    <div class="qf-row-card-top">
                        <form method="post" asp-page-handler="ToggleEnabled" asp-route-id="@rule.Id">
                            <div class="qf-toggle-switch">
                                <input type="checkbox" role="switch"
                                       @(rule.Enabled ? "checked" : "") onchange="this.form.submit()"
                                       aria-label="Toggle @rule.Name" />
                            </div>
                        </form>
                        <span class="qf-row-card-title is-flex-grow-1">@rule.Name</span>
                        <div class="dropdown is-right qf-row-card-actions" :class="{ 'is-active': open }" x-data="{ open: false }" @@click.outside="open = false">
                            <div class="dropdown-trigger">
                                <button class="button is-small border-0" type="button"
                                        @@click="open = !open" aria-haspopup="true" :aria-expanded="open.toString()" aria-label="Actions for @rule.Name">
                                    <i class="ti ti-dots-vertical" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="dropdown-menu" role="menu">
                                <div class="dropdown-content">
                                    <a class="dropdown-item" asp-page="/Rules/Edit" asp-route-id="@rule.Id"><i class="ti ti-pencil me-2" aria-hidden="true"></i>Edit</a>
                                    <form method="post" asp-page-handler="Duplicate" asp-route-id="@rule.Id">
                                        <button type="submit" class="dropdown-item"><i class="ti ti-clipboard me-2" aria-hidden="true"></i>Duplicate</button>
                                    </form>
                                    <hr class="dropdown-divider" />
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@rule.Id"
                                          onsubmit="return confirm('Delete rule &quot;@rule.Name&quot;?');">
                                        <button type="submit" class="dropdown-item has-text-danger"><i class="ti ti-trash me-2" aria-hidden="true"></i>Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(rule.Description))
                    {
                        <div class="small text-secondary">@rule.Description</div>
                    }
                    @if (rule.DryRun)
                    {
                        <span class="qf-badge qf-badge-secondary mt-1">dry-run</span>
                    }
                    <dl class="qf-row-card-meta">
                        <dt>Schedule</dt>
                        <dd class="text-truncate" title="@rule.CronExpression (@rule.TimeZoneId)">
                            @TorrentRuler.Engine.Scheduling.CronDescriptionService.Describe(rule.CronExpression)
                        </dd>
                        <dt>Last run</dt>
                        <dd>
                            @if (rule.LastRunAt is not null)
                            {
                                <partial name="_RelativeTime" model="rule.LastRunAt.Value" />
                            }
                            else
                            {
                                <span>never</span>
                            }
                        </dd>
                    </dl>
                    <form method="post" asp-page-handler="RunNow" asp-route-id="@rule.Id" class="mt-2">
                        <button type="submit" class="button is-small is-success is-light qf-ico-btn is-fullwidth">
                            <i class="ti ti-player-play" aria-hidden="true"></i>Run now
                        </button>
                    </form>
                </div>
            }
            </div>
        }
    </div>
</div>

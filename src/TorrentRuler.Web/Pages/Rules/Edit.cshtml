@page "{id:int?}"
@model TorrentRuler.Web.Pages.Rules.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add rule" : "Edit rule";
}

<div id="qf-rule-editor-data"
     data-source-catalog="@Model.SourceCatalogJson"
     hidden></div>
<script>
    (function () {
        var el = document.getElementById('qf-rule-editor-data');
        window.qfSourceCatalog = JSON.parse(el.dataset.sourceCatalog);
        window.qfUdfHelpers = [
        @foreach (var h in Model.UdfHelpers)
        {
            @: { signature: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(h.Signature)), description: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(h.Description)) },
        }
        ];
    })();
</script>

<div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
    <h1 class="title is-4 mb-0">@(Model.IsNew ? "Add rule" : $"Edit rule: {Model.Input.Name}")</h1>
    <button class="button is-small qf-ico-btn" type="button" x-data @@click="$store.fieldPanel.open = true"><i class="ti ti-database" aria-hidden="true"></i>Field reference</button>
</div>

<div asp-validation-summary="All" class="has-text-danger mb-3"></div>

<form method="post">
    <input type="hidden" asp-for="Input.Id" />

    <div class="qf-card mb-3">
        <div class="qf-card-header"><h2>Basics</h2></div>
        <div class="qf-card-body">
            <div class="columns is-multiline is-variable is-3">
                <div class="column is-6-tablet">
                    <label asp-for="Input.Name" class="label"></label>
                    <input asp-for="Input.Name" class="input" />
                </div>
                <div class="column is-2-tablet">
                    <label asp-for="Input.Priority" class="label"></label>
                    <input asp-for="Input.Priority" type="number" class="input" />
                </div>
                <div class="column is-2-tablet is-flex is-align-items-end">
                    <div class="qf-check">
                        <input asp-for="Input.Enabled" />
                        <label asp-for="Input.Enabled"></label>
                    </div>
                </div>
                <div class="column is-2-tablet is-flex is-align-items-end">
                    <div class="qf-check">
                        <input asp-for="Input.DryRun" />
                        <label asp-for="Input.DryRun"></label>
                    </div>
                </div>
                <div class="column is-12">
                    <label asp-for="Input.Description" class="label"></label>
                    <input asp-for="Input.Description" class="input" />
                </div>
                <div class="column is-12">
                    <div class="qf-check">
                        <input asp-for="Input.StopOnMatch" />
                        <label asp-for="Input.StopOnMatch"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="qf-card mb-3">
        <div class="qf-card-header"><h2>Schedule</h2></div>
        <div class="qf-card-body">
            <div class="columns is-multiline is-variable is-3 is-align-items-end">
                <div class="column is-4-tablet">
                    <label asp-for="Input.CronExpression" class="label"></label>
                    <input asp-for="Input.CronExpression" id="cronExpressionInput" class="input qf-muted-mono" />
                </div>
                <div class="column is-3-tablet">
                    <label class="label">Common schedules</label>
                    <div class="select is-fullwidth">
                        <select onchange="if(this.value){document.getElementById('cronExpressionInput').value=this.value;}">
                            <option value="">Choose one…</option>
                            @foreach (var preset in TorrentRuler.Engine.Scheduling.CommonSchedulePresets.Presets)
                            {
                                <option value="@preset.CronExpression">@preset.Label</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="column is-3-tablet">
                    <label asp-for="Input.TimeZoneId" class="label"></label>
                    <input asp-for="Input.TimeZoneId" class="input" placeholder="UTC" />
                </div>
                <div class="column is-2-tablet">
                    <button type="button" class="button is-primary is-light is-fullwidth qf-ico-btn"
                            hx-post="?handler=PreviewSchedule" hx-target="#schedule-preview" hx-swap="innerHTML"><i class="ti ti-eye" aria-hidden="true"></i>Preview</button>
                </div>
            </div>
            <div class="help mb-2">Minimum interval is 5 minutes; faster schedules are rejected with an explanation.</div>
            <pre id="schedule-preview" class="qf-sql-preview mb-0" style="display:@(string.IsNullOrEmpty(Model.Input.CronExpression) ? "none" : "block")"></pre>
        </div>
    </div>

    <div class="qf-card mb-3">
        <div class="qf-card-header">
            <h2>Condition</h2>
            <button class="button is-small qf-ico-btn" type="button" x-data @@click="$store.fieldPanel.open = true"><i class="ti ti-database" aria-hidden="true"></i>Field reference</button>
            <div class="is-flex is-align-items-center is-gap-2">
                <span class="qf-field-type" id="conditionModeLabel">@(Model.Input.UseAdvancedSql ? "Advanced SQL" : "Basic builder")</span>
                <input type="hidden" asp-for="Input.UseAdvancedSql" id="useAdvancedSqlValue" />
                <button type="button" class="button is-small text-nowrap qf-ico-btn" id="conditionModeToggle">
                    <i class="ti ti-refresh" aria-hidden="true"></i><span data-mode-label>@(Model.Input.UseAdvancedSql ? "Switch to basic" : "Switch to SQL")</span>
                </button>
            </div>
        </div>
        <div class="qf-card-body">
            <div id="visualBuilder" style="display:@(Model.Input.UseAdvancedSql ? "none" : "block")">
                <div id="qf-condition-builder-root" data-initial="@Model.Input.ConditionTreeJson"
                     x-data="conditionBuilder($el.dataset.initial, qfSourceCatalog)">
                    <input type="hidden" name="Input.ConditionTreeJson" :value="serialize()" />

                    <div class="qf-cond-group">
                        <div class="is-flex is-align-items-center is-gap-2 mb-2">
                            <span class="small text-secondary">Match</span>
                            <div class="select is-small">
                                <select x-model="root.Operator">
                                    <option value="And">ALL of</option>
                                    <option value="Or">ANY of</option>
                                </select>
                            </div>
                            <span class="small text-secondary">the following:</span>
                        </div>

                        <template x-for="(row, idx) in root.Children" :key="idx">
                            <div>
                                <template x-if="row.kind === 'comparison'">
                                    <div class="qf-cond-row is-flex is-flex-wrap-wrap is-gap-2 is-align-items-center">
                                        <div class="select is-small">
                                            <select x-model="row._source" x-init="$nextTick(() => $el.value = row._source)" @@change="onSourceChange(row, false)">
                                                <template x-for="s in topSources" :key="s.value">
                                                    <option :value="s.value" x-text="s.label"></option>
                                                </template>
                                            </select>
                                        </div>
                                        <div class="select is-small">
                                            <select x-model="row._field" x-init="$nextTick(() => $el.value = row._field)" @@change="onFieldChange(row, false)">
                                                <template x-for="f in fieldsFor(row._source, false)" :key="f.key">
                                                    <option :value="f.key" x-text="f.key"></option>
                                                </template>
                                            </select>
                                        </div>
                                        <div class="select is-small">
                                            <select x-model="row.Operator" x-init="$nextTick(() => $el.value = row.Operator)">
                                                <template x-for="op in operatorsFor(row._valueType)" :key="op">
                                                    <option :value="op" x-text="operatorLabel(op)"></option>
                                                </template>
                                            </select>
                                        </div>
                                        <template x-if="row.Operator === 'In' || row.Operator === 'NotIn'">
                                            <input class="input is-small" style="min-width:180px; width:auto;" placeholder="comma, separated, values" x-model="row._rawListValue" />
                                        </template>
                                        <template x-if="row.Operator !== 'In' && row.Operator !== 'NotIn' && row.Operator !== 'IsNull' && row.Operator !== 'IsNotNull'">
                                            <input class="input is-small" style="width:auto;" x-model="row._rawValue" />
                                        </template>
                                        <button type="button" class="button is-small is-danger is-light ms-auto" @@click="removeRow(root.Children, row)"><i class="ti ti-x" aria-hidden="true"></i><span class="is-sr-only">Remove</span></button>
                                    </div>
                                </template>

                                <template x-if="row.kind === 'exists'">
                                    <div class="qf-cond-row">
                                        <div class="is-flex is-flex-wrap-wrap is-gap-2 is-align-items-center mb-2">
                                            <div class="select is-small">
                                                <select x-model="row.Negate">
                                                    <option :value="true">There is NO</option>
                                                    <option :value="false">There IS</option>
                                                </select>
                                            </div>
                                            <div class="select is-small">
                                                <select x-model="row.Source" x-init="$nextTick(() => $el.value = row.Source)" @@change="onExistsSourceChange(row)">
                                                    <template x-for="s in existsSources" :key="s.value">
                                                        <option :value="s.value" x-text="s.label"></option>
                                                    </template>
                                                </select>
                                            </div>
                                            <span class="small text-secondary">matching:</span>
                                            <button type="button" class="button is-small is-danger is-light ms-auto" @@click="removeRow(root.Children, row)"><i class="ti ti-x" aria-hidden="true"></i><span class="is-sr-only">Remove</span></button>
                                        </div>
                                        <div class="is-flex is-flex-wrap-wrap is-gap-2 is-align-items-center ps-3">
                                            <div class="select is-small">
                                                <select x-model="row.Condition._field" x-init="$nextTick(() => $el.value = row.Condition._field)" @@change="onFieldChange(row.Condition, true)">
                                                    <template x-for="f in fieldsFor(row.Source, true)" :key="f.key">
                                                        <option :value="f.key" x-text="f.key"></option>
                                                    </template>
                                                </select>
                                            </div>
                                            <div class="select is-small">
                                                <select x-model="row.Condition.Operator" x-init="$nextTick(() => $el.value = row.Condition.Operator)">
                                                    <template x-for="op in operatorsFor(row.Condition._valueType)" :key="op">
                                                        <option :value="op" x-text="operatorLabel(op)"></option>
                                                    </template>
                                                </select>
                                            </div>
                                            <input class="input is-small" style="width:auto;" x-show="row.Condition.Operator !== 'IsNull' && row.Condition.Operator !== 'IsNotNull'" x-model="row.Condition._rawValue" />
                                        </div>
                                    </div>
                                </template>

                                <template x-if="row.kind === 'group'">
                                    <div class="qf-cond-group">
                                        <div class="is-flex is-align-items-center is-gap-2 mb-2">
                                            <span class="small text-secondary">Match</span>
                                            <div class="select is-small">
                                                <select x-model="row.Operator">
                                                    <option value="And">ALL of</option>
                                                    <option value="Or">ANY of</option>
                                                </select>
                                            </div>
                                            <span class="small text-secondary">(nested group):</span>
                                            <button type="button" class="button is-small is-danger is-light ms-auto qf-ico-btn" @@click="removeRow(root.Children, row)"><i class="ti ti-x" aria-hidden="true"></i>Remove group</button>
                                        </div>

                                        <template x-for="(subRow, subIdx) in row.Children" :key="subIdx">
                                            <div>
                                                <template x-if="subRow.kind === 'comparison'">
                                                    <div class="qf-cond-row is-flex is-flex-wrap-wrap is-gap-2 is-align-items-center">
                                                        <div class="select is-small">
                                                            <select x-model="subRow._source" x-init="$nextTick(() => $el.value = subRow._source)" @@change="onSourceChange(subRow, false)">
                                                                <template x-for="s in topSources" :key="s.value">
                                                                    <option :value="s.value" x-text="s.label"></option>
                                                                </template>
                                                            </select>
                                                        </div>
                                                        <div class="select is-small">
                                                            <select x-model="subRow._field" x-init="$nextTick(() => $el.value = subRow._field)" @@change="onFieldChange(subRow, false)">
                                                                <template x-for="f in fieldsFor(subRow._source, false)" :key="f.key">
                                                                    <option :value="f.key" x-text="f.key"></option>
                                                                </template>
                                                            </select>
                                                        </div>
                                                        <div class="select is-small">
                                                            <select x-model="subRow.Operator" x-init="$nextTick(() => $el.value = subRow.Operator)">
                                                                <template x-for="op in operatorsFor(subRow._valueType)" :key="op">
                                                                    <option :value="op" x-text="operatorLabel(op)"></option>
                                                                </template>
                                                            </select>
                                                        </div>
                                                        <template x-if="subRow.Operator === 'In' || subRow.Operator === 'NotIn'">
                                                            <input class="input is-small" style="min-width:180px; width:auto;" placeholder="comma, separated, values" x-model="subRow._rawListValue" />
                                                        </template>
                                                        <template x-if="subRow.Operator !== 'In' && subRow.Operator !== 'NotIn' && subRow.Operator !== 'IsNull' && subRow.Operator !== 'IsNotNull'">
                                                            <input class="input is-small" style="width:auto;" x-model="subRow._rawValue" />
                                                        </template>
                                                        <button type="button" class="button is-small is-danger is-light ms-auto" @@click="removeRow(row.Children, subRow)"><i class="ti ti-x" aria-hidden="true"></i><span class="is-sr-only">Remove</span></button>
                                                    </div>
                                                </template>
                                                <template x-if="subRow.kind === 'exists'">
                                                    <div class="qf-cond-row">
                                                        <div class="is-flex is-flex-wrap-wrap is-gap-2 is-align-items-center mb-2">
                                                            <div class="select is-small">
                                                                <select x-model="subRow.Negate">
                                                                    <option :value="true">There is NO</option>
                                                                    <option :value="false">There IS</option>
                                                                </select>
                                                            </div>
                                                            <div class="select is-small">
                                                                <select x-model="subRow.Source" x-init="$nextTick(() => $el.value = subRow.Source)" @@change="onExistsSourceChange(subRow)">
                                                                    <template x-for="s in existsSources" :key="s.value">
                                                                        <option :value="s.value" x-text="s.label"></option>
                                                                    </template>
                                                                </select>
                                                            </div>
                                                            <span class="small text-secondary">matching:</span>
                                                            <button type="button" class="button is-small is-danger is-light ms-auto" @@click="removeRow(row.Children, subRow)"><i class="ti ti-x" aria-hidden="true"></i><span class="is-sr-only">Remove</span></button>
                                                        </div>
                                                        <div class="is-flex is-flex-wrap-wrap is-gap-2 is-align-items-center ps-3">
                                                            <div class="select is-small">
                                                                <select x-model="subRow.Condition._field" x-init="$nextTick(() => $el.value = subRow.Condition._field)" @@change="onFieldChange(subRow.Condition, true)">
                                                                    <template x-for="f in fieldsFor(subRow.Source, true)" :key="f.key">
                                                                        <option :value="f.key" x-text="f.key"></option>
                                                                    </template>
                                                                </select>
                                                            </div>
                                                            <div class="select is-small">
                                                                <select x-model="subRow.Condition.Operator" x-init="$nextTick(() => $el.value = subRow.Condition.Operator)">
                                                                    <template x-for="op in operatorsFor(subRow.Condition._valueType)" :key="op">
                                                                        <option :value="op" x-text="operatorLabel(op)"></option>
                                                                    </template>
                                                                </select>
                                                            </div>
                                                            <input class="input is-small" style="width:auto;" x-show="subRow.Condition.Operator !== 'IsNull' && subRow.Condition.Operator !== 'IsNotNull'" x-model="subRow.Condition._rawValue" />
                                                        </div>
                                                    </div>
                                                </template>
                                            </div>
                                        </template>

                                        <div class="is-flex is-gap-2 mt-2">
                                            <button type="button" class="button is-small qf-ico-btn" @@click="addSubComparison(row)"><i class="ti ti-plus" aria-hidden="true"></i>Condition</button>
                                            <button type="button" class="button is-small qf-ico-btn" @@click="addSubExists(row)"><i class="ti ti-plus" aria-hidden="true"></i>Related-source check</button>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </template>

                        <div class="is-flex is-gap-2 mt-2">
                            <button type="button" class="button is-small qf-ico-btn" @@click="addComparison()"><i class="ti ti-plus" aria-hidden="true"></i>Condition</button>
                            <button type="button" class="button is-small qf-ico-btn" @@click="addExists()"><i class="ti ti-plus" aria-hidden="true"></i>Related-source check</button>
                            <button type="button" class="button is-small qf-ico-btn" @@click="addGroup()"><i class="ti ti-plus" aria-hidden="true"></i>Group (nested AND/OR)</button>
                        </div>
                    </div>

                    <div class="mt-2">
                        <button type="button" class="button is-small is-primary is-light qf-ico-btn" hx-post="?handler=PreviewCondition" hx-target="#condition-sql-preview" hx-swap="innerHTML"><i class="ti ti-eye" aria-hidden="true"></i>Preview SQL</button>
                    </div>
                    <pre id="condition-sql-preview" class="qf-sql-preview mt-2" style="display:none"></pre>
                </div>
            </div>

            <div id="advancedSqlBuilder" style="display:@(Model.Input.UseAdvancedSql ? "block" : "none")">

                <label asp-for="Input.AdvancedSqlWhere" class="label"></label>
                <textarea asp-for="Input.AdvancedSqlWhere" class="textarea qf-muted-mono" rows="4"
                          placeholder="qbittorrent.*.category = 'linux' AND qbittorrent.*.size_gb > 5"></textarea>
                <div class="help">A boolean WHERE-clause expression against the documented schema. Any key from the field reference can be used directly (e.g. <code>qbittorrent.*.active_days &gt;= 14</code>, <code>storage.&lt;name&gt;.used_percent &lt; 90</code>, <code>tautulli.*.play_count = 0</code>). A per-row field of a related source has no single value here &mdash; use one of its aggregates instead. Runs read-only, single-statement only.</div>
                <button type="button" class="button is-small is-primary is-light mt-2 qf-ico-btn"
                        hx-post="?handler=ValidateAdvancedSql" hx-target="#advanced-sql-preview" hx-swap="innerHTML"><i class="ti ti-check" aria-hidden="true"></i>Validate</button>
                <pre id="advanced-sql-preview" class="qf-sql-preview mt-2" style="display:none"></pre>
            </div>
        </div>
    </div>

    <div class="qf-card mb-3">
        <div class="qf-card-header"><h2>Actions</h2></div>
        <div class="qf-card-body">
            @* Scopes which instances' torrents the actions below touch, so it belongs with them
               rather than in Basics. Plain checkboxes outside the Alpine scope -- they post
               Input.TargetInstanceIds directly, like any other form field. *@
            <div class="mb-3">
                <label class="label">Apply actions to:</label>
                @if (Model.QbtInstances.Count == 0)
                {
                    <div class="text-secondary small">No qBittorrent instances configured yet. <a asp-page="/Instances/Edit">Add one</a>.</div>
                }
                else
                {
                    <div class="is-flex is-flex-wrap-wrap is-gap-3">
                        @foreach (var instance in Model.QbtInstances)
                        {
                            <div class="qf-check">
                                <input type="checkbox" name="Input.TargetInstanceIds" value="@instance.Id"
                                       id="target-@instance.Id" checked="@Model.Input.TargetInstanceIds.Contains(instance.Id)" />
                                <label for="target-@instance.Id">@instance.Name</label>
                            </div>
                        }
                    </div>
                    <div class="help">Leave every box unchecked to apply to all of them.</div>
                }
            </div>
            <hr class="my-3" />

            <div id="qf-action-builder-root" data-initial="@Model.Input.ActionsJson" x-data="actionBuilder($el.dataset.initial)">
                <input type="hidden" name="Input.ActionsJson" :value="serialize()" />

                <template x-for="(action, idx) in actions" :key="idx">
                    <div class="qf-cond-row is-flex is-flex-wrap-wrap is-gap-2 is-align-items-center">
                        <div class="select is-small">
                            <select x-model="action.type">
                                <option value="add_tags">Add tag(s)</option>
                                <option value="remove_tags">Remove tag(s)</option>
                                <option value="set_category">Set category</option>
                                <option value="move">Move</option>
                                <option value="set_upload_limit">Set upload limit</option>
                                <option value="set_download_limit">Set download limit</option>
                                <option value="export_torrent">Export .torrent file</option>
                                <option value="start">Start torrent</option>
                                <option value="stop">Stop torrent</option>
                            </select>
                        </div>

                        <template x-if="action.type === 'add_tags' || action.type === 'remove_tags'">
                            <input class="input is-small" placeholder="tag1, tag2" x-model="action._tags" />
                        </template>
                        <template x-if="action.type === 'set_category'">
                            <input class="input is-small" style="width:auto;" placeholder="category" x-model="action.Category" />
                        </template>
                        <template x-if="action.type === 'move'">
                            <span class="is-flex is-flex-wrap-wrap is-gap-2 is-align-items-center">
                                <input class="input is-small" placeholder="/media/cold-storage" x-model="action.DestinationPath" />
                                <label class="qf-check small mb-0">
                                    <input type="checkbox" x-model="action.WaitForCompletion" /> wait for completion
                                </label>
                            </span>
                        </template>
                        <template x-if="action.type === 'set_upload_limit' || action.type === 'set_download_limit'">
                            <input type="number" class="input is-small" style="width:auto;" placeholder="bytes/sec, 0=unlimited" x-model="action.LimitBytesPerSec" />
                        </template>
                        <template x-if="action.type === 'export_torrent'">
                            <span class="is-flex is-flex-wrap-wrap is-gap-2 is-align-items-center">
                                <input class="input is-small" placeholder="/exports (a path inside the torrentruler container)" x-model="action.DestinationPath" />
                                <div class="select is-small">
                                    <select x-model="action.Layout">
                                        <option value="Flat">flat folder</option>
                                        <option value="PerCategory">subfolder per category</option>
                                    </select>
                                </div>
                            </span>
                        </template>

                        <button type="button" class="button is-small is-danger is-light ms-auto" @@click="removeAction(idx)"><i class="ti ti-x" aria-hidden="true"></i><span class="is-sr-only">Remove</span></button>
                    </div>
                </template>

                <button type="button" class="button is-small mt-2 qf-ico-btn" @@click="addAction('add_tags')"><i class="ti ti-plus" aria-hidden="true"></i>Action</button>
            </div>
        </div>
    </div>

    <div class="is-flex is-gap-2 mb-2 is-align-items-center">
        <button type="submit" formaction="?handler=Save" class="button is-primary qf-ico-btn"><i class="ti ti-device-floppy" aria-hidden="true"></i>Save rule</button>
        <a asp-page="/Rules/Index" class="button">Cancel</a>
        <span id="dry-run-spinner" class="htmx-indicator small text-secondary qf-ico-btn">
            <span class="qf-spinner" role="status" aria-hidden="true"></span>evaluating&hellip;
        </span>
        <button type="button" class="button is-primary is-light ms-auto qf-ico-btn"
                hx-post="?handler=DryRun" hx-include="closest form"
                hx-target="#dry-run-result" hx-swap="innerHTML"
                hx-indicator="#dry-run-spinner" hx-disabled-elt="this"><i class="ti ti-player-play" aria-hidden="true"></i>Dry run</button>

    </div>
    <div class="help mb-2">Evaluates the rule as currently entered (including unsaved changes) and shows what it would match and do — nothing is applied.</div>
    <div id="dry-run-result" class="mb-5"></div>
</form>

<div class="qf-drawer-backdrop" x-data x-show="$store.fieldPanel.open" @@click="$store.fieldPanel.open = false" style="display:none"></div>
<div class="qf-drawer" :class="{ 'is-active': $store.fieldPanel.open }"
     x-data="fieldReferencePanel(qfSourceCatalog, qfUdfHelpers)"
     style="display: flex; flex-direction: column;">
    <div class="is-flex is-justify-content-space-between is-align-items-center p-3 border-bottom">
        <h2 class="title is-5 mb-0">Field reference</h2>
        <button type="button" class="delete" @@click="$store.fieldPanel.open = false" aria-label="Close"></button>
    </div>
    <div class="is-flex is-flex-direction-column p-0" style="flex: 1; min-height: 0;">

        <div class="tabs px-3 pt-2 is-flex-shrink-0">
            <ul>
                <li :class="{ 'is-active': tab === 'fields' }">
                    <a @@click="tab = 'fields'">Fields</a>
                </li>
                <li :class="{ 'is-active': tab === 'helpers' }">
                    <a @@click="tab = 'helpers'">Helpers</a>
                </li>
            </ul>
        </div>

        <div class="is-flex-grow-1" style="display: flex; flex-direction: column; min-height: 0;" x-show="tab === 'fields'">
            <div class="p-3 border-bottom is-flex-shrink-0">
                <div class="is-flex is-gap-2 mb-2">
                    <input type="search" class="input is-small" placeholder="Search fields…" x-model="search" />
                    <button type="button" class="button is-small text-nowrap qf-ico-btn" :data-copy="visibleKeys">
                        <i class="ti ti-clipboard" aria-hidden="true"></i><span data-copy-label>Copy all</span>
                    </button>
                </div>
                <div class="select is-small is-fullwidth">
                    <select x-model="typeFilter">
                        <option value="">All sources</option>
                        <template x-for="t in types" :key="t.value">
                            <option :value="t.value" x-text="t.label"></option>
                        </template>
                    </select>
                </div>
            </div>
            <div style="overflow-y: auto; flex: 1;">
                <template x-for="row in filteredRows" :key="row.key">
                    <div class="qf-field-row is-flex is-align-items-start is-gap-2" :data-copy="row.key" title="Click to copy">
                        <div class="is-flex-grow-1">
                            <div class="qf-field-key" x-text="row.key"></div>
                            <div class="qf-field-type" x-text="row.valueType + ' · ' + row.source"></div>
                            <div class="small text-secondary" x-text="row.description"></div>
                        </div>
                        <button type="button" class="button is-small text-nowrap qf-ico-btn" :data-copy="row.key">
<i class="ti ti-clipboard" aria-hidden="true"></i><span data-copy-label>Copy</span>
                        </button>
                    </div>
                </template>
            </div>
        </div>

        <div class="is-flex-grow-1" style="display: flex; flex-direction: column; min-height: 0;" x-show="tab === 'helpers'">
            <div class="p-3" style="overflow-y: auto; flex: 1;">
                <h6 class="small is-uppercase text-secondary">Helper functions</h6>
                <template x-for="h in udfHelpers" :key="h.signature">
                    <div class="mb-2">
                        <div class="qf-field-key" x-text="h.signature"></div>
                        <div class="small text-secondary" x-text="h.description"></div>
                    </div>
                </template>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* CodeMirror highlights the advanced-SQL box. Must come before rule-editor.js,
       which mounts it on DOMContentLoaded. *@
    <link rel="stylesheet" href="~/lib/codemirror/lib/codemirror.min.css" />
    <link rel="stylesheet" href="~/lib/codemirror/theme/material-darker.min.css" />
    <script src="~/lib/codemirror/lib/codemirror.min.js"></script>
    <script src="~/lib/codemirror/mode/sql/sql.min.js"></script>
    <script src="~/lib/codemirror/addon/edit/matchbrackets.min.js"></script>
    <script src="~/js/rule-editor.js" asp-append-version="true"></script>
}

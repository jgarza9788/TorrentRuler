@model TorrentRuler.Engine.RulePreview

@if (!Model.Ok)
{
    <div class="alert alert-danger py-2 px-3 mb-0">
        <strong>Dry run failed.</strong>
        <div class="small mt-1" style="white-space: pre-wrap; word-break: break-word;">@Model.Error</div>
    </div>
}
else
{
    <div class="qf-card">
        <div class="qf-card-body">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="qf-badge @(Model.MatchedCount > 0 ? "qf-badge-success" : "qf-badge-secondary")">
                    <span class="qf-badge-dot"></span>@Model.MatchedCount matched
                </span>
                <span class="small text-secondary">of @Model.TorrentsInSnapshot torrent(s) in the current snapshot</span>
            </div>

            @if (Model.Actions.Count == 0)
            {
                <div class="small text-secondary">No actions configured — this rule wouldn't change anything.</div>
            }
            else if (Model.MatchedCount == 0)
            {
                <div class="small text-secondary">Nothing matched, so no actions would run.</div>
            }
            else
            {
                <ul class="list-unstyled mb-0 small">
                    @foreach (var line in Model.Actions)
                    {
                        <li class="mb-1">
                            <span class="fw-medium">@line.Description</span>
                            &mdash;
                            <span class="text-success">@line.WouldChange would change</span>@if (line.AlreadyMatching > 0)
                            {
                                <span class="text-secondary">, @line.AlreadyMatching already match</span>
                            }@if (line.Failed > 0)
                            {
                                <span class="text-danger">, @line.Failed could not be read</span>
                            }
                        </li>
                    }
                </ul>
            }

            @if (Model.Query is { IsValid: true, SampleRows.Count: > 0 } query)
            {
                <div class="small text-secondary mt-2">What the query returns (all columns):</div>
                <partial name="_QuerySampleTable" model="query" />
            }

            <div class="form-text mt-2">Preview only — nothing was changed.</div>

            @if (Model.SampleMatches.Count > 0)
            {
                <h3 class="h6 mt-3 mb-2">Matched torrents
                    <span class="text-secondary fw-normal">@(Model.MatchedCount > Model.SampleMatches.Count ? $"(showing {Model.SampleMatches.Count} of {Model.MatchedCount})" : $"({Model.MatchedCount})")</span>
                </h3>
                <div class="qf-table-wrap qf-dry-run-table">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Name</th><th>Instance</th><th class="text-end">Size</th><th>Tags</th></tr></thead>
                        <tbody>
                        @foreach (var t in Model.SampleMatches)
                        {
                            <tr>
                                <td class="qf-cell-wrap" title="@t.Hash">@t.Name</td>
                                <td class="text-secondary">@t.InstanceName</td>
                                <td class="text-end text-nowrap">@TorrentRuler.Web.Format.Bytes(t.SizeBytes)</td>
                                <td>@foreach (var tag in t.Tags) { <span class="qf-badge qf-badge-secondary me-1">@tag</span> }</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
